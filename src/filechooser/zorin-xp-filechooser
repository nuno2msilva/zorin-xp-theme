    # ------------------------------------------------------------ estado
    @staticmethod
    def _load_state():
        try:
            with open(STATE_FILE, encoding="utf-8") as f:
                st = json.load(f)
            return st if isinstance(st, dict) else {}
        except (OSError, ValueError):
            return {}

    def _save_state(self):
        self.state.update({"view": self.view_mode, "sort": list(self.sort),
                           "size": [self.box.base[0] + self.box.grow[0], self.box.base[1] + self.box.grow[1]]})
        try:
            os.makedirs(os.path.dirname(STATE_FILE), exist_ok=True)
            tmp = STATE_FILE + ".tmp"
            with open(tmp, "w", encoding="utf-8") as f:
                json.dump(self.state, f)
            os.replace(tmp, STATE_FILE)
        except OSError:
            pass

    # ------------------------------------------------------------ pieces
    def _set_transient(self, *_):
        pw = self._parent_window or ""
        if pw.startswith("x11:"):
            try:
                gi.require_version("GdkX11", "3.0")
                from gi.repository import GdkX11
                xid = int(pw[4:], 16)
                foreign = GdkX11.X11Window.foreign_new_for_display(Gdk.Display.get_default(), xid)
                if foreign:
                    self.get_window().set_transient_for(foreign)
            except Exception:
                pass

    def _tool(self, name, tip, callback, arrow=False):
        btn = Gtk.Button()
        btn.get_style_context().add_class("zxp-tool")
        btn.set_relief(Gtk.ReliefStyle.NONE)
        btn.set_focus_on_click(False)
        box = Gtk.Box(spacing=2)
        img = Gtk.Image.new_from_file(os.path.join(DATA, f"tb-{name}-normal.png"))
        box.pack_start(img, False, False, 0)
        if arrow:
            # the button's arrow (BTNS_WHOLEDROPDOWN): black 5 x 3 triangle
            surf = cairo.ImageSurface(cairo.FORMAT_ARGB32, 5, 3)
            cr = cairo.Context(surf)
            cr.set_source_rgb(0, 0, 0)
            for i in range(3):
                cr.rectangle(i, i, 5 - 2 * i, 1)
            cr.fill()
            arr = Gtk.Image.new_from_surface(surf)
            arr.set_valign(Gtk.Align.START)
            arr.set_margin_top(7)
            box.pack_start(arr, False, False, 0)
        btn.add(box)
        btn.set_tooltip_text(plain(tip) if tip else None)
        btn.img, btn.icon = img, name

        def state(*_):
            st = "disabled" if not btn.get_sensitive() else ("hot" if btn.get_state_flags() & Gtk.StateFlags.PRELIGHT else "normal")
            img.set_from_file(os.path.join(DATA, f"tb-{name}-{st}.png"))
        btn.connect("state-flags-changed", state)
        btn.connect("clicked", lambda b: callback(b) if arrow else callback())
        return btn

    def _place_button(self, path):
        btn = Gtk.Button()
        btn.set_relief(Gtk.ReliefStyle.NONE)
        btn.set_focus_on_click(False)
        v = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        img = Gtk.Image.new_from_pixbuf(icon_pixbuf(place_icon(path), 32))
        # (up to 2 lines of 83 px, broken like XP's DrawText)
        lab = Gtk.Label(label=xp_wrap(place_name(path), PLACE_TEXT_W, lambda s: self._measure(self, s), 2))
        lab.set_justify(Gtk.Justification.CENTER)
        lab.set_attributes(line_attrs())
        v.pack_start(img, False, False, 0)
        v.pack_start(lab, False, False, 0)
        btn.add(v)
        btn.set_size_request(-1, PLACE_H)
        btn.set_sensitive(os.path.isdir(path))
        btn.connect("clicked", lambda *_: self.navigate(path))
        self.place_buttons[path] = btn
        return btn

    def _indent(self, layout, cell, model, it, data=None):
        cell.set_property("xpad", model[it][3] * 10 + 2 if self._popup else 2)

    def _on_popup(self, *_):
        self._popup = self.look.get_property("popup-shown")
        self.look.queue_draw()

    # ------------------------------------------------------------ pega do canto
    def _clamp_grow(self):
        mon = None
        try:
            display = Gdk.Display.get_default()
            win = self.get_window()
            mon = display.get_monitor_at_window(win) if win else display.get_primary_monitor()
        except Exception:
            pass
        area = mon.get_workarea() if mon is not None else None
        if area is not None and area.width > self.box.base[0] and area.height > self.box.base[1]:
            self.box.grow[0] = min(self.box.grow[0], max(0, area.width - self.box.base[0] - 8))
            self.box.grow[1] = min(self.box.grow[1], max(0, area.height - self.box.base[1] - 40))
        self.box.grow = [max(0, self.box.grow[0]), max(0, self.box.grow[1])]

    def _grip_press(self, _w, ev):
        if ev.button == 1 and ev.type == Gdk.EventType.BUTTON_PRESS:
            self._grip = (ev.x_root, ev.y_root, list(self.box.grow))
        return True

    def _grip_motion(self, _w, ev):
        if not self._grip:
            return False
        x0, y0, (gw, gh) = self._grip
        new = [max(0, gw + int(ev.x_root - x0)), max(0, gh + int(ev.y_root - y0))]
        if new != self.box.grow:
            self.box.grow = new
            self._clamp_grow()
            self.box.queue_resize()
        return True

    # ------------------------------------------------------------ vistas
    def _views_menu(self, button):
        menu = self._view_submenu()
        menu.attach_to_widget(button, None)
        menu.show_all()
        menu.popup_at_widget(button, Gdk.Gravity.SOUTH_WEST, Gdk.Gravity.NORTH_WEST, None)

    def _view_submenu(self):
        menu = Gtk.Menu()
        group = None
        for mode in VIEWS:
            default = {"thumbnails": "Miniat&uras", "tiles": "&Mosaicos", "icons": "Í&cones",
                       "list": "&Lista", "details": "Detal&hes"}[mode]
            item = Gtk.RadioMenuItem.new_with_mnemonic_from_widget(group, mnemonic(t(mode, default)))
            group = item
            item.set_active(self.view_mode == mode)
            item.connect("toggled", lambda it, m=mode: it.get_active() and self.set_view(m))
            menu.append(item)
        return menu

    def view_widget(self):
        return {"list": self.flow, "details": self.tree}.get(self.view_mode, self.icons)

    def focus_view(self):
        """The focus on the list (in List, on the selected item: the FlowBox does
        not keep it itself)."""
        if self.view_mode == "list":
            sel = self.flow.get_selected_children()
            ch = sel[0] if sel else self.flow.get_child_at_index(0)
            if ch is not None:
                ch.grab_focus()
            return
        self.view_widget().grab_focus()

    def set_view(self, mode, remember=True):
        sel = self.selected() if self.cwd else []
        self.finish_edit(True)
        self.view_mode = mode
        if mode in GRID:
            self.icons.set_item_width(GRID[mode][0])
            self.icons.queue_resize()
            self.icons.queue_draw()
        # (GtkStack ignores pages that are still hidden: before the window's
        # show_all the first one stayed, the grids', empty in List/Details)
        page = self.stack.get_child_by_name("items" if mode in GRID else mode)
        page.show_all()
        self.stack.set_visible_child(page)
        if sel:
            GLib.idle_add(lambda: self.select_entries(sel) and False)
        if remember:
            self._save_state()

    def _view_focused(self, widget=None):
        widget = widget or self.view_widget()
        foc = self.get_focus()
        return bool(foc is not None and (self.is_active() or TEST) and (foc is widget or foc.is_ancestor(widget)))

    def _focus_changed(self):
        self._sync_list_sel()
        self.icons.queue_draw()
        self.tree.queue_draw()
        return False

    def _measure(self, widget, text):
        w = self._wcache.get(text)
        if w is None:
            w = self._wcache[text] = widget.create_pango_layout(text).get_pixel_size()[0]
        return w

    def _wrap(self, widget, text, width, lines):
        key = (text, width, lines)
        out = self._wcache.get(key)
        if out is None:
            out = self._wcache[key] = xp_wrap(text, width, lambda s: self._measure(widget, s), lines)
        return out

    def _is_cursor(self, e):
        ok, path, _cell = self.icons.get_cursor()
        return bool(ok and path is not None and self.store[path][0] is e)

    def _draw_icon(self, cr, e, size, x, y, blend):
        pb = e.icon(size)
        if pb is None:
            return
        if blend:
            cr.set_source_surface(blended(pb), x, y)
        else:
            Gdk.cairo_set_source_pixbuf(cr, pb, x, y)
        cr.paint()

    def _tile_lines(self, e):
        """Tiles: images with their dimensions and type, other files with the
        type and size, folders with the name only (as in XP)."""
        if e.is_dir:
            return []
        kind = e.type_name()
        if (e.ctype or "").startswith("image/"):
            dims = e.cache.get("dims")
            if dims is None:
                try:
                    fmt_, w, h = GdkPixbuf.Pixbuf.get_file_info(e.path)
                    dims = f"{w} x {h}" if fmt_ is not None and w > 0 and h > 0 else ""
                except (GLib.Error, TypeError):
                    dims = ""
                e.cache["dims"] = dims
            if dims:
                return [dims, kind]
        return [kind, human_size(e.size)]

    @staticmethod
    def _tile_top(captions):
        return (GRID["tiles"][1] - LINE * (1 + captions)) // 2 - 2

    def draw_item(self, cr, widget, area, e, selected):
        mode = self.view_mode
        if e is None or mode not in GRID:
            return
        focus = self._view_focused(widget)
        x, y = area.x, area.y
        cr.save()
        if mode == "thumbnails":
            # the 96 x 96 frame (1 px #ECE9D8 over the edge); when selected, 3 px of
            # blue outside (beige without the focus)
            fx, fy = x + THUMB_FRAME[0], y + THUMB_FRAME[1]
            cr.set_source_rgb(1, 1, 1)
            cr.rectangle(fx, fy, 96, 96)
            cr.fill()
            pb = self._thumb(e)
            if pb is not None:
                w, h = pb.get_width(), pb.get_height()
                Gdk.cairo_set_source_pixbuf(cr, pb, fx + (96 - w) // 2, fy + (96 - h) // 2)
                cr.rectangle(fx, fy, 96, 96)
                cr.fill()
            else:
                self._draw_icon(cr, e, 48, fx + 24, fy + 24, False)
            if selected:
                cr.set_source_rgb(*rgb(HIGHLIGHT if focus else FACE))
                cr.set_line_width(3)
                cr.rectangle(fx - 1.5, fy - 1.5, 99, 99)
            else:
                cr.set_source_rgb(*rgb(FACE))
                cr.set_line_width(1)
                cr.rectangle(fx + 0.5, fy + 0.5, 95, 95)
            cr.stroke()
            self._draw_name(cr, widget, e, x + 2, y + NAME_TOP[mode], NAME_W[mode], selected, focus, thumbs=True)
        elif mode == "icons":
            self._draw_icon(cr, e, 32, x + ICON_AT[mode][0], y + ICON_AT[mode][1], selected and focus)
            self._draw_name(cr, widget, e, x + 2, y + NAME_TOP[mode], NAME_W[mode], selected, focus)
        else:
            self._draw_icon(cr, e, 48, x + ICON_AT[mode][0], y + ICON_AT[mode][1], selected and focus)
            caps = self._tile_lines(e)
            top = y + self._tile_top(len(caps))
            tx = x + TILE_TEXT_X
            name = self._wrap(widget, e.name, TILE_TEXT_W, 1)
            if selected:
                cr.set_source_rgb(*rgb(HIGHLIGHT if focus else FACE))
                cr.rectangle(tx - 2, top - 1, self._measure(widget, name) + 4, LINE + 2)
                cr.fill()
            draw_text(cr, widget, name, tx, top, (255, 255, 255) if selected and focus else (0, 0, 0))
            for i, cap in enumerate(caps):
                draw_text(cr, widget, self._wrap(widget, cap, TILE_TEXT_W, 1), tx, top + (i + 1) * LINE, GREY)
        cr.restore()

    def _draw_name(self, cr, widget, e, x, top, width, selected, focus, thumbs=False):
        """The name under the icon: up to 2 lines, centred; the focused item's in
        full, on top of whatever is below it (as in XP)."""
        full = focus and self._is_cursor(e)
        lines = self._wrap(widget, e.name, width, None if full else 2).split("\n")
        ws = [self._measure(widget, ln) for ln in lines]
        tw = max(ws)
        if selected:
            cr.set_source_rgb(*rgb(HIGHLIGHT if focus else FACE))
            # (in Thumbnails the highlight starts tight against the text and ends 2 px below)
            cr.rectangle(x + (width - tw) // 2 - 2, top if thumbs else top - 1, tw + 4, LINE * len(lines) + 2)
            cr.fill()
        color = (255, 255, 255) if selected and focus else (0, 0, 0)
        for i, ln in enumerate(lines):
            draw_text(cr, widget, ln, x + (width - ws[i]) // 2, top + i * LINE, color)

    def draw_name_cell(self, cr, widget, bg, e, selected):
        if e is None:
            return
        cr.save()
        if self.sort[0] == "name":
            cr.set_source_rgb(*rgb(SORTED_BG))
            cr.rectangle(bg.x, bg.y, bg.width, bg.height)
            cr.fill()
        focus = self._view_focused(widget)
        self._draw_icon(cr, e, 16, bg.x + 4, bg.y + (bg.height - 16) // 2, selected and focus)
        tx = bg.x + DETAIL_TEXT_X
        name = self._wrap(widget, e.name, max(8, bg.width - DETAIL_TEXT_X - 6), 1)
        if selected:
            cr.set_source_rgb(*rgb(HIGHLIGHT if focus else FACE))
            cr.rectangle(tx - 1, bg.y, self._measure(widget, name) + 2, bg.height)
            cr.fill()
        draw_text(cr, widget, name, tx, bg.y + (bg.height - LINE) // 2,
                  (255, 255, 255) if selected and focus else (0, 0, 0))
        cr.restore()

    def _detail_text(self, col, cell, model, it, key):
        e = model[it][0]
        if key == "size":
            text = "" if e.is_dir else human_size(e.size)
        elif key == "type":
            text = e.type_name()
        else:
            text = time.strftime("%d-%m-%Y %H:%M", time.localtime(e.mtime))
        cell.set_property("text", text)
        if self.sort[0] == key:
            cell.set_property("cell-background-rgba", Gdk.RGBA(*rgb(SORTED_BG), 1))
        else:
            cell.set_property("cell-background-set", False)

    def _tree_band(self, tree, cr):
        """The sorted column in grey down to the bottom of the list, as in XP."""
        col = self.columns.get(self.sort[0])
        if col is None:
            return False
        n = len(self.store)
        if n:
            r = tree.get_background_area(Gtk.TreePath(n - 1), col)
            y = tree.convert_bin_window_to_widget_coords(0, r.y + r.height)[1]
        else:
            y = tree.convert_bin_window_to_widget_coords(0, 0)[1]
        x = tree.convert_tree_to_widget_coords(col.get_x_offset(), 0)[0]
        h = tree.get_allocated_height() - y
        if h > 0:
            cr.set_source_rgb(*rgb(SORTED_BG))
            cr.rectangle(x, y, col.get_width(), h)
            cr.fill()
        return False

    def _thumb(self, e):
        if "thumb" in e.cache:
            return e.cache["thumb"]
        e.cache["thumb"] = None
        if not e.is_dir:
            self._thumb_queue.append(e)
            if not self._thumb_idle:
                self._thumb_idle = GLib.idle_add(self._load_thumbs)
        return None

    def _load_thumbs(self):
        t0 = time.monotonic()
        while self._thumb_queue and time.monotonic() - t0 < 0.03:
            e = self._thumb_queue.pop(0)
            e.cache["thumb"] = load_thumb(e)
        self.icons.queue_draw()
        if self._thumb_queue:
            return True
        self._thumb_idle = 0
        return False

    # ------------------------------------------------------------ navigation
    def current_filter(self):
        i = self.types.get_active()
        return self.filters[i] if self.filters and i >= 0 else None

    def navigate(self, path, remember=True):
        path = os.path.abspath(os.path.expanduser(path))
        if not os.path.isdir(path):
            return
        self.finish_edit(True)
        if remember and self.cwd and self.cwd != path:
            self.history.append(self.cwd)
        self.cwd = path
        self.refresh(keep=False)
        self._fill_look()
        self.btn_back.set_sensitive(bool(self.history))
        self.btn_up.set_sensitive(path != "/")
        self.btn_new.set_sensitive(os.access(path, os.W_OK))
        for p, b in self.place_buttons.items():
            ctx = b.get_style_context()
            (ctx.add_class if p == path else ctx.remove_class)("zxp-current")

    def go_back(self):
        if self.history:
            p = self.history.pop()
            self.navigate(p, remember=False)
            self.btn_back.set_sensitive(bool(self.history))

    def go_up(self):
        if self.cwd and self.cwd != "/":
            self.navigate(os.path.dirname(self.cwd))

    def _fill_look(self):
        """Ambiente de trabalho > Os meus documentos / O meu computador > ... /
        Os meus locais na rede, with the current path in the right place."""
        rows = [(DESKTOP, 0), (DOCUMENTS, 1), (HOME, 1)]
        mounts = []
        for m in Gio.VolumeMonitor.get().get_mounts():
            root = m.get_root().get_path()
            if root and root != "/":
                mounts.append((root, m.get_name(), m.get_icon()))
        rows.append(("/", 2))
        rows += [(r, 2) for r, _n, _i in mounts]
        rows.append((NETWORK, 1))
        # the current path: from the closest place that contains it
        cur = self.cwd
        if cur not in [r for r, _ in rows]:
            anchors = [(r, lvl) for r, lvl in rows if r != NETWORK and
                       (cur == r or cur.startswith(r.rstrip("/") + "/"))]
            if anchors:
                anchor, lvl = max(anchors, key=lambda a: len(a[0]))
                rel = os.path.relpath(cur, anchor).split(os.sep)
                chain = []
                p = anchor
                for i, part in enumerate(rel):
                    p = os.path.join(p, part)
                    chain.append((p, lvl + 1 + i))
                pos = [r for r, _ in rows].index(anchor) + 1
                rows[pos:pos] = chain
        self.look.handler_block(self.look_changed)
        self.look_store.clear()
        active = 0
        names = {r: n for r, n, _i in mounts}
        for i, (p, lvl) in enumerate(rows):
            name = place_name(p) or names.get(p) or os.path.basename(p) or p
            self.look_store.append([file_icon(p, True, None, 16), name, p, lvl])
            if p == cur:
                active = i
        self.look.set_active(active)
        self.look.handler_unblock(self.look_changed)

    def _on_look(self, *_):
        it = self.look.get_active_iter()
        if it:
            path = self.look_store[it][2]
            if path != self.cwd:
                self.navigate(path)

    def refresh(self, keep=True):
        sel = [e.name for e in self.selected()] if keep else []
        flt = self.current_filter()
        entries = [e for e in list_dir(self.cwd) if (not self.directory or e.is_dir) and matches(e, flt)]
        self.entries = sort_entries(entries, *self.sort)
        self._thumb_queue.clear()
        for ch in self.flow.get_children():
            self.flow.remove(ch)
        self.store.clear()
        for e in self.entries:
            self._add_row(e)
        self.flow.show_all()
        self._sync_columns()
        if sel:
            self.select_entries([e for e in self.entries if e.name in sel])

    def _add_row(self, e):
        self.store.append([e])
        row = Gtk.Box(spacing=2)
        img = Gtk.Image.new_from_pixbuf(e.icon(16))
        lab = Gtk.Label(label=e.name)
        lab.set_xalign(0)
        row.pack_start(img, False, False, 0)
        row.pack_start(lab, False, False, 0)
        child = Gtk.FlowBoxChild()
        child.add(row)
        child.entry, child.img, child.lab = e, img, lab
        self.flow.add(child)
        child.show_all()
        return child

    def _sync_columns(self):
        for key, col in self.columns.items():
            on = self.sort[0] == key
            col.set_sort_indicator(on)
            if on:
                col.set_sort_order(Gtk.SortType.DESCENDING if self.sort[1] else Gtk.SortType.ASCENDING)
        self.tree.queue_draw()

    def sort_by(self, key, toggle=False):
        if toggle and self.sort[0] == key:
            self.sort = (key, not self.sort[1])
        else:
            self.sort = (key, SORT_DESC[key])
        self.refresh()
        self._save_state()

    # ------------------------------------------------------------ selection
    def selected(self):
        if self.view_mode == "list":
            return [ch.entry for ch in self.flow.get_selected_children()]
        if self.view_mode == "details":
            model, paths = self.tree.get_selection().get_selected_rows()
            return [model[p][0] for p in paths]
        return [self.store[p][0] for p in sorted(self.icons.get_selected_items())]

    def select_entries(self, entries):
        idx = [self.entries.index(e) for e in entries if e in self.entries]
        mode = self.view_mode
        if mode == "list":
            self.flow.unselect_all()
            for i in idx:
                self.flow.select_child(self.flow.get_child_at_index(i))
            if idx:
                ch = self.flow.get_child_at_index(idx[0])
                a = ch.get_allocation()
                adj = self.sw_list.get_hadjustment()
                if a.x < adj.get_value() or a.x + a.width > adj.get_value() + adj.get_page_size():
                    adj.set_value(min(a.x, adj.get_upper() - adj.get_page_size()))
        elif mode == "details":
            s = self.tree.get_selection()
            s.unselect_all()
            for i in idx:
                s.select_path(Gtk.TreePath(i))
            if idx:
                self.tree.scroll_to_cell(Gtk.TreePath(idx[0]), None, False, 0, 0)
        else:
            self.icons.unselect_all()
            for i in idx:
                self.icons.select_path(Gtk.TreePath(i))
            if idx:
                self.icons.set_cursor(Gtk.TreePath(idx[0]), None, False)
                self.icons.scroll_to_path(Gtk.TreePath(idx[0]), False, 0, 0)
        return True

    def _sync_list_sel(self):
        focus = self._view_focused(self.flow)
        for ch in self.flow.get_children():
            sel = ch.is_selected()
            ctx = ch.lab.get_style_context()
            (ctx.add_class if sel and focus else ctx.remove_class)("zxp-sel")
            (ctx.add_class if sel and not focus else ctx.remove_class)("zxp-sel-dim")
            if sel and focus:
                ch.img.set_from_surface(blended(ch.entry.icon(16)))
            else:
                ch.img.set_from_pixbuf(ch.entry.icon(16))

    def _on_select(self):
        sel = self.selected()
        files = [e for e in sel if not e.is_dir]
        if self.kind == "save" and files:
            self.entry.set_text(files[0].name)
        elif self.kind == "open" and not self.directory and files:
            self.entry.set_text(files[0].name if len(files) == 1 else " ".join(f'"{e.name}"' for e in files))

    def activate_entry(self, e):
        if e.is_dir:
            self.navigate(e.path)
        elif not self.directory:
            self.entry.set_text(e.name)
            self.accept()

    # ------------------------------------------------------------ right click
    def _on_view_button(self, view, ev):
        if ev.type != Gdk.EventType.BUTTON_PRESS or ev.button != 3:
            return False
        e = self._entry_at(view, ev)
        if e is not None and e not in self.selected():
            self.select_entries([e])
        elif e is None:
            self.select_entries([])
        self.focus_view()
        menu = self._item_menu(self.selected()) if e is not None else self._background_menu()
        menu.attach_to_widget(view, None)
        menu.show_all()
        menu.popup_at_pointer(ev)
        return True

    def _entry_at(self, view, ev):
        if view is self.icons:
            path = self.icons.get_path_at_pos(int(ev.x), int(ev.y))
            return self.store[path][0] if path is not None else None
        if view is self.tree:
            hit = self.tree.get_path_at_pos(int(ev.x), int(ev.y))
            return self.store[hit[0]][0] if hit else None
        ch = self.flow.get_child_at_pos(int(ev.x), int(ev.y))
        return ch.entry if ch is not None else None

    def _menu_item(self, key, default, callback, bold=False, sensitive=True):
        text = mnemonic(t(key, default))
        item = Gtk.MenuItem.new_with_mnemonic(text)
        if bold:
            item.get_child().set_markup_with_mnemonic(f"<b>{GLib.markup_escape_text(text)}</b>")
        item.set_sensitive(sensitive)
        if callback:
            item.connect("activate", lambda *_: GLib.idle_add(lambda: callback() and False))
        return item

    def _background_menu(self):
        """The list background's menu, as in XP: View, Arrange Icons By, Refresh,
        New > Folder (without Paste/Paste Shortcut, disabled)."""
        menu = Gtk.Menu()
        view = self._menu_item("view", "&Ver", None)
        view.set_submenu(self._view_submenu())
        menu.append(view)
        menu.append(Gtk.SeparatorMenuItem())
        arrange = self._menu_item("arrange", "&Dispor ícones por", None)
        sub = Gtk.Menu()
        # (in XP no dot and without the disabled grouping/arranging options)
        for key, label in (("name", t("colName", "Nome")), ("size", t("colSize", "Tamanho")),
                           ("type", t("colType", "Tipo")), ("mtime", "Modificado")):
            item = Gtk.MenuItem.new_with_mnemonic(mnemonic(label))
            item.connect("activate", lambda _it, k=key: self.sort_by(k))
            sub.append(item)
        arrange.set_submenu(sub)
        menu.append(arrange)
        menu.append(self._menu_item("refresh", "Actuali&zar", lambda: self.refresh()))
        menu.append(Gtk.SeparatorMenuItem())
        new = self._menu_item("new", "&Novo", None, sensitive=os.access(self.cwd, os.W_OK))
        sub = Gtk.Menu()
        sub.append(self._menu_item("newFolderItem", "&Pasta", self.new_folder))
        new.set_submenu(sub)
        menu.append(new)
        return menu

    def _item_menu(self, sel):
        """The items' menu: "Abrir" (folders) or "Seleccionar" (files) in bold,
        Delete, Rename, Properties."""
        menu = Gtk.Menu()
        files = [e for e in sel if not e.is_dir]
        writable = os.access(self.cwd, os.W_OK)
        if len(sel) == 1 and sel[0].is_dir:
            menu.append(self._menu_item("open", "&Abrir", lambda: self.navigate(sel[0].path), bold=True))
        elif files and not self.directory:
            menu.append(self._menu_item("select", "Selecc&ionar", lambda: self._choose(files), bold=True))
        if menu.get_children():
            menu.append(Gtk.SeparatorMenuItem())
        menu.append(self._menu_item("delete", "Elimina&r", lambda: self.delete_selected(), sensitive=writable))
        menu.append(self._menu_item("rename", "&Mudar o nome", lambda: self.start_edit(sel[0]),
                                    sensitive=writable and len(sel) == 1))
        menu.append(Gtk.SeparatorMenuItem())
        menu.append(self._menu_item("properties", "&Propriedades",
                                    lambda: self.show_properties([e.path for e in sel])))
        return menu

    def _choose(self, files):
        if len(files) == 1:
            self.activate_entry(files[0])
        elif self.multiple:
            self.entry.set_text(" ".join(f'"{e.name}"' for e in files))
            self.accept()

    def show_properties(self, paths):
        """Files' Properties (org.freedesktop.FileManager1)."""
        uris = [Gio.File.new_for_path(p).get_uri() for p in paths]
        try:
            bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)
            bus.call("org.freedesktop.FileManager1", "/org/freedesktop/FileManager1",
                     "org.freedesktop.FileManager1", "ShowItemProperties",
                     GLib.Variant("(ass)", (uris, "")), None, Gio.DBusCallFlags.NONE, -1, None, None)
        except GLib.Error:
            pass

    # ------------------------------------------------------------ new folder / delete
    def new_folder(self):
        if not self.cwd or not os.access(self.cwd, os.W_OK):
            return
        base = t("newFolder", "Nova pasta")
        name, n = base, 2
        while os.path.lexists(os.path.join(self.cwd, name)):
            name, n = f"{base} ({n})", n + 1
        path = os.path.join(self.cwd, name)
        try:
            os.mkdir(path)
        except OSError as err:
            self.xp_msgbox(self.get_title(), err.strerror or str(err), "error")
            return
        e = make_entry(path)
        if e is None:
            return
        # (as in XP: at the end of the list until refreshed, already being renamed)
        self.entries.append(e)
        self._add_row(e)
        # (after the view has placed the new item)
        GLib.timeout_add(30, lambda: self.start_edit(e) and False)

    def _remove_entry(self, e):
        if e not in self.entries:
            return
        i = self.entries.index(e)
        self.entries.pop(i)
        del self.store[i]
        ch = self.flow.get_child_at_index(i)
        if ch is not None:
            self.flow.remove(ch)

    def _update_entry(self, e):
        if e not in self.entries:
            return
        i = self.entries.index(e)
        it = self.store.get_iter(Gtk.TreePath(i))
        self.store.row_changed(Gtk.TreePath(i), it)
        ch = self.flow.get_child_at_index(i)
        if ch is not None:
            ch.lab.set_text(e.name)
            ch.img.set_from_pixbuf(e.icon(16))
        self._sync_list_sel()
        self.icons.queue_draw()

    def _trash_has_items(self):
        try:
            info = Gio.File.new_for_uri("trash:///").query_info("trash::item-count", Gio.FileQueryInfoFlags.NONE, None)
            return info.get_attribute_uint32("trash::item-count") > 0
        except GLib.Error:
            return False

    def delete_selected(self, permanent=False):
        """Delete with XP's question (Recycle Bin; Shift+Delete: permanently)."""
        sel = self.selected()
        if not sel or not os.access(self.cwd, os.W_OK):
            return
        name = sel[0].name
        if len(sel) > 1:
            title = t("confirmMany", "Confirmar eliminação de vários ficheiros")
            text = fmt(t("killMany") if permanent else t("askMany"), len(sel))
            icon = "kill-many" if permanent else None
        elif sel[0].is_dir:
            title = t("confirmFolder", "Confirmar eliminação de pasta(s)")
            text = fmt(t("killFolder"), name, "", t("allContents")) if permanent else fmt(t("askFolder"), name)
            icon = "kill-folder" if permanent else None
        else:
            title = t("confirmFile", "Confirmar eliminação de ficheiro(s)")
            text = fmt(t("killFile") if permanent else t("askFile"), name)
            icon = "kill-file" if permanent else None
        if icon is None:
            icon = "bin-full" if self._trash_has_items() else "bin-empty"
        if self.xp_confirm(title, text, icon, many=len(sel) > 1) != 0:
            return
        done = False
        for e in sel:
            try:
                if not permanent:
                    Gio.File.new_for_path(e.path).trash(None)
                elif e.is_dir and not os.path.islink(e.path):
                    shutil.rmtree(e.path)
                else:
                    os.remove(e.path)
            except (OSError, GLib.Error) as err:
                msg = err.message if isinstance(err, GLib.Error) else (err.strerror or str(err))
                self.xp_msgbox(title, f"{e.name}: {msg}", "error")
                break
            self._remove_entry(e)
            done = True
        if done and not permanent:
            play_sound(os.path.join(SOUNDS, "Windows XP Recycle.wav"))

    # ------------------------------------------------------------ rename in place
    def start_edit(self, e, text=None):
        """The name box over the item, as in XP (F2, Rename, New folder): a single
        line in Tiles, List and Details; several in Icons and Thumbnails,
        centred, if the name does not fit."""
        if e not in self.entries:
            return
        self.finish_edit(True)
        self.select_entries([e])
        GLib.idle_add(self._begin_edit, e, text)

    def _begin_edit(self, e, text):
        if e not in self.entries or self._finished:
            return False
        mode = self.view_mode
        centred = mode in NAME_W
        before, after = (5, 5) if centred else ((4, 15) if mode == "tiles" else (2, 15))
        text = e.name if text is None else text
        multi = centred and self._measure(self, text) > NAME_W[mode]
        if multi:
            tv = Gtk.TextView(wrap_mode=Gtk.WrapMode.WORD_CHAR, justification=Gtk.Justification.CENTER)
            tv.set_left_margin(before)
            tv.set_right_margin(after)
            tv.get_style_context().add_class("zxp-rename")
            tv.get_buffer().set_text(text)
            widget = Gtk.Frame()
            widget.set_shadow_type(Gtk.ShadowType.IN)
            widget.get_style_context().add_class("zxp-rename")
            widget.add(tv)
            editor = tv
            editor.get_buffer().connect("changed", lambda *_: self._place_editor())
        else:
            editor = widget = Gtk.Entry()
            widget.set_text(text)
            ctx = widget.get_style_context()
            ctx.add_class("zxp-rename")
            if not centred:
                ctx.add_class("zxp-rename-left" if mode == "tiles" else "zxp-rename-list")
            widget.set_activates_default(False)
            editor.connect("changed", lambda *_: self._place_editor())
            editor.connect("activate", lambda *_: self.finish_edit(True))
        editor.connect("key-press-event", self._editor_key)
        editor.connect("focus-out-event", self._editor_focus_out)
        # (in a window of its own: the views have theirs, which would end up on top)
        holder = Gtk.EventBox()
        holder.set_visible_window(True)
        holder.add(widget)
        holder.connect("realize", lambda w: w.get_window().raise_())
        widget = holder
        self._edit = {"entry": e, "widget": widget, "editor": editor, "multi": multi, "mode": mode,
                      "centred": centred, "before": before, "after": after, "since": time.monotonic(),
                      "timer": GLib.timeout_add(50, self._follow_editor)}
        self.box.put(widget, 0, 0)
        self.box.editor = (widget, [0, 0, 1, 1])
        self._place_editor()
        widget.show_all()
        editor.grab_focus()
        # the name without the extension is selected, as in XP
        stem = len(text) if e.is_dir else len(os.path.splitext(text)[0] or text)
        if multi:
            buf = editor.get_buffer()
            buf.select_range(buf.get_start_iter(), buf.get_iter_at_offset(stem))
        else:
            editor.select_region(0, stem)
        return False

    def _editor_text(self):
        ed = self._edit
        if ed["multi"]:
            buf = ed["editor"].get_buffer()
            return buf.get_text(buf.get_start_iter(), buf.get_end_iter(), False)
        return ed["editor"].get_text()

    def _label_geom(self, e):
        """Where the item's name is (window coordinates)."""
        if e not in self.entries:
            return None
        i = self.entries.index(e)
        mode = self.view_mode
        if mode in GRID:
            ok, r = self.icons.get_cell_rect(Gtk.TreePath(i), None)
            if not ok:
                return None
            co = self.icons.translate_coordinates(self.box, r.x, r.y)
            if co is None:
                return None
            bx, by = co
            if mode in NAME_TOP:
                return {"centre": bx + 2 + NAME_W[mode] / 2, "top": by + NAME_TOP[mode]}
            return {"left": bx + TILE_TEXT_X, "top": by + self._tile_top(len(self._tile_lines(e)))}
        if mode == "details":
            r = self.tree.get_background_area(Gtk.TreePath(i), self.name_col)
            wx, wy = self.tree.convert_bin_window_to_widget_coords(r.x, r.y)
            co = self.tree.translate_coordinates(self.box, wx, wy)
            if co is None:
                return None
            return {"left": co[0] + DETAIL_TEXT_X, "row": co[1], "height": r.height}
        ch = self.flow.get_child_at_index(i)
        if ch is None:
            return None
        co = ch.lab.translate_coordinates(self.box, 1, 0)
        cy = ch.translate_coordinates(self.box, 0, 0)
        if co is None or cy is None:
            return None
        return {"left": co[0], "row": cy[1], "height": ch.get_allocated_height()}

    def _place_editor(self):
        ed = self._edit
        if not ed:
            return
        g = self._label_geom(ed["entry"])
        if g is None:
            return
        text = self._editor_text()
        mode = ed["mode"]
        if ed["multi"]:
            nw = NAME_W[mode]
            lay = self.create_pango_layout(text or " ")
            lay.set_width(nw * Pango.SCALE)
            lay.set_wrap(Pango.WrapMode.WORD_CHAR)
            w = nw + ed["before"] + ed["after"] + 2
            h = lay.get_pixel_size()[1] + 2
            x = g["centre"] - nw / 2 - ed["before"] - 1
        else:
            tw = self._measure(self, text)
            w = tw + ed["before"] + ed["after"] + 2
            h = 17
            if ed["centred"]:
                x = g["centre"] - tw / 2 - ed["before"] - 1
            else:
                x = g["left"] - ed["before"] - 1
        if "row" in g:
            y = g["row"] + (g["height"] - 17) // 2
        else:
            y = g["top"] - 2 + (1 if mode == "thumbnails" else 0)
        # (without leaving the list through the sides)
        frame = self.stack.get_allocation()
        x = max(frame.x, min(x, frame.x + frame.width - w))
        rect = [round(x), round(y), int(w), int(h)]
        if self.box.editor and self.box.editor[1] != rect:
            self.box.editor = (ed["widget"], rect)
            self.box.queue_resize()

    def _follow_editor(self):
        if not self._edit:
            return False
        self._place_editor()
        return True

    def _editor_key(self, _w, ev):
        if ev.keyval == Gdk.KEY_Escape:
            self.finish_edit(False)
            return True
        if ev.keyval in (Gdk.KEY_Return, Gdk.KEY_KP_Enter):
            self.finish_edit(True)
            return True
        return False

    def _editor_focus_out(self, *_):
        ed = self._edit
        if not ed:
            return False
        # (right after opening, the view may still keep the focus)
        if time.monotonic() - ed["since"] < 0.4:
            GLib.idle_add(lambda: self._edit is ed and ed["editor"].grab_focus() and False)
            return False
        GLib.idle_add(lambda: self._edit is ed and self.finish_edit(True))
        return False

    def finish_edit(self, commit):
        ed = self._edit
        if not ed:
            return
        self._edit = None
        GLib.source_remove(ed["timer"])
        text = (self._editor_text_of(ed) or "").replace("\n", " ").strip()
        self.box.editor = None
        ed["widget"].destroy()
        if not self._finished:
            self.focus_view()
        e = ed["entry"]
        if commit and text and text != e.name:
            GLib.idle_add(self._apply_rename, e, text)

    @staticmethod
    def _editor_text_of(ed):
        if ed["multi"]:
            buf = ed["editor"].get_buffer()
            return buf.get_text(buf.get_start_iter(), buf.get_end_iter(), False)
        return ed["editor"].get_text()

    def _apply_rename(self, e, new):
        title = t("renameError", "Erro ao mudar o nome a ficheiro ou pasta")
        if "/" in new or new in (".", ".."):
            self.xp_msgbox(title, t("badChars"), "error")
            self.start_edit(e, new)
            return False
        if not e.is_dir and os.path.splitext(e.name)[1].lower() != os.path.splitext(new)[1].lower():
            if self.xp_msgbox(plain(t("rename", "Mudar o nome")), t("askExtension"), "warning",
                              ("yes", "no")) != 0:
                return False
        target = os.path.join(os.path.dirname(e.path), new)
        same = os.path.lexists(target) and os.path.samefile(target, e.path)
        if os.path.lexists(target) and not same:
            self.xp_msgbox(title, fmt(t("renameFailed"), t("nameExists"), e.name), "error")
            self.start_edit(e, new)
            return False
        try:
            os.rename(e.path, target)
        except OSError as err:
            self.xp_msgbox(title, fmt(t("renameFailed"), err.strerror or str(err), e.name), "error")
            return False
        e.name, e.path = new, target
        e.ctype = None if e.is_dir else Gio.content_type_guess(new, None)[0]
        e.cache.clear()
        self._update_entry(e)
        self._on_select()
        return False

    # ------------------------------------------------------------ caixas do XP
    def _modal(self, title, fixed, buttons, default, escape=None):
        """Shows a box and waits for the answer (the button's index)."""
        win = Gtk.Window(title=title, transient_for=self, modal=True, resizable=False)
        win.set_type_hint(Gdk.WindowTypeHint.DIALOG)
        win.set_skip_taskbar_hint(True)
        win.set_position(Gtk.WindowPosition.CENTER_ON_PARENT)
        win.get_style_context().add_class("zxp-msgbox")
        win.add(fixed)
        result = [None]
        loop = GLib.MainLoop()

        def answer(i):
            if result[0] is None:
                result[0] = i
                win.destroy()
                loop.quit()
        for i, b in enumerate(buttons):
            b.connect("clicked", lambda _b, i=i: answer(i))
        win.connect("delete-event", lambda *_: (escape is not None and answer(escape)) or True)
        win.connect("key-press-event", lambda _w, ev: (answer(escape), True)[1]
                    if ev.keyval == Gdk.KEY_Escape and escape is not None else False)
        buttons[default].set_can_default(True)
        win.set_default(buttons[default])
        win.show_all()
        buttons[default].grab_focus()
        if TEST_REPLY:      # (test mode only: it answers by itself)
            GLib.timeout_add(1500, lambda: answer(default) or False)
        loop.run()
        return result[0]

    def _msg_label(self, text):
        lab = Gtk.Label(label=text, xalign=0, yalign=0)
        lab.set_attributes(line_attrs())
        lab.get_style_context().add_class("zxp-msgbox-text")
        return lab

    def xp_msgbox(self, title, text, icon="warning", buttons=("ok",), default=0):
        """A user32 MessageBox (MB_ICONEXCLAMATION | MB_YESNO, ...): 11 px margin,
        the icon and the text centred on each other, the text at 62 px, the
        75 x 23 buttons (6 px apart) centred, 17 px below."""
        play_sound(event={"warning": "dialog-warning", "error": "dialog-error",
                          "info": "dialog-information"}.get(icon, "dialog-warning"))
        # (the text broken at words at 5/8 of the screen width, as in user32)
        limit = 640
        try:
            limit = Gdk.Display.get_default().get_primary_monitor().get_workarea().width * 5 // 8
        except Exception:
            pass
        lines = [xp_wrap(par, limit, lambda s: self._measure(self, s), None) if par else ""
                 for par in text.replace("\r\n", "\n").split("\n")]
        lines = "\n".join(lines).split("\n")
        tw = max(self._measure(self, ln) for ln in lines) if lines else 0
        th = LINE * len(lines)
        tih = max(32, th)
        bw = len(buttons) * 75 + (len(buttons) - 1) * 6
        cw = max(62 + tw + 8, bw + 22)
        by = 11 + tih + 17
        fixed = Gtk.Fixed()
        fixed.set_size_request(cw, by + 23 + 11)
        fixed.put(Gtk.Image.new_from_file(os.path.join(DATA, f"msg-{icon}.png")), 11, 11 + (tih - 32) // 2)
        lab = self._msg_label("\n".join(lines))
        lab.set_size_request(tw, th)
        fixed.put(lab, 62, 11 + (tih - th) // 2)
        btns = []
        x = (cw - bw) // 2
        for key in buttons:
            b = Gtk.Button.new_with_mnemonic(mnemonic(t(key, {"ok": "OK", "yes": "&Sim", "no": "&Não"}[key])))
            b.set_size_request(75, 23)
            fixed.put(b, x, by)
            btns.append(b)
            x += 81
        escape = len(buttons) - 1 if buttons == ("ok",) else None
        return self._modal(title, fixed, btns, default, escape)

    def xp_confirm(self, title, text, icon, many=False):
        """shell32's delete confirmation (dialogs 1011-1013, Tahoma 8 = 1.5 px per
        unit): 412 x 127 (several: 412 x 97), the icon at (15, 15), the text
        beside it, Sim / Não at the bottom right. 0 = Yes."""
        fixed = Gtk.Fixed()
        fixed.set_size_request(412, 97 if many else 127)
        fixed.put(Gtk.Image.new_from_file(os.path.join(DATA, f"msg-{icon}.png")), 15, 15)
        width = 336 if many else 330
        wrapped = "\n".join(xp_wrap(par, width, lambda s: self._measure(self, s), None) if par else ""
                            for par in text.split("\n"))
        lab = self._msg_label(wrapped)
        fixed.put(lab, 62 if many else 57, 21 if many else 15)
        btns = []
        for key, x in ((("yes", 220), ("no", 315)) if many else (("yes", 236), ("no", 322))):
            b = Gtk.Button.new_with_mnemonic(mnemonic(t(key, {"yes": "&Sim", "no": "&Não"}[key])))
            b.set_size_request(87 if many else 80, 23)
            fixed.put(b, x, 63 if many else 93)
            btns.append(b)
        return self._modal(title, fixed, btns, 0, escape=1)

    # ------------------------------------------------------------ teclado
    def _on_key(self, _w, ev):
        if self._edit:
            return False
        state = ev.state & Gtk.accelerator_get_default_mod_mask()
        in_view = self._view_focused()
        key = ev.keyval
        if key == Gdk.KEY_Escape:
            self.finish(1)
            return True
        if key == Gdk.KEY_F5:
            self.refresh()
            return True
        if in_view and key in (Gdk.KEY_Delete, Gdk.KEY_KP_Delete):
            self.delete_selected(permanent=bool(state & Gdk.ModifierType.SHIFT_MASK))
            return True
        if in_view and key == Gdk.KEY_F2:
            sel = self.selected()
            if len(sel) == 1 and os.access(self.cwd, os.W_OK):
                self.start_edit(sel[0])
            return True
        if in_view and (key == Gdk.KEY_Menu or (key == Gdk.KEY_F10 and state & Gdk.ModifierType.SHIFT_MASK)):
            sel = self.selected()
            menu = self._item_menu(sel) if sel else self._background_menu()
            menu.attach_to_widget(self.view_widget(), None)
            menu.show_all()
            menu.popup_at_widget(self.view_widget(), Gdk.Gravity.NORTH_WEST, Gdk.Gravity.NORTH_WEST, None)
            return True
        if key == Gdk.KEY_BackSpace and not self.entry.has_focus():
            self.go_up()
            return True
        return False

    # ------------------------------------------------------------ resposta
    def _names(self):
        text = self.entry.get_text().strip()
        if '"' in text:
            return [p for p in text.split('"') if p.strip()]
        return [text] if text else []

    def accept(self):
        self.finish_edit(True)
        names = self._names()
        title = self.get_title()
        if self.directory:
            sel = [e for e in self.selected() if e.is_dir]
            if names and os.path.isdir(os.path.join(self.cwd, names[0])) and not sel:
                target = os.path.join(self.cwd, names[0])
            else:
                target = sel[0].path if sel else self.cwd
            if self.kind == "savefiles":
                files = [bytes(f).rstrip(b"\0").decode("utf-8", "replace") for f in self.options.get("files") or []]
                uris = [Gio.File.new_for_path(os.path.join(target, os.path.basename(f))).get_uri() for f in files]
            else:
                uris = [Gio.File.new_for_path(target).get_uri()]
            self.finish(0, uris)
            return
        if not names:
            sel = [e for e in self.selected() if not e.is_dir]
            names = [e.name for e in sel]
            if not names:
                return
        paths = []
        for n in names:
            p = os.path.expanduser(n)
            paths.append(p if os.path.isabs(p) else os.path.join(self.cwd, p))
        if len(paths) == 1 and os.path.isdir(paths[0]):
            self.navigate(paths[0])
            self.entry.set_text("" if self.kind == "open" else os.path.basename(self.options.get("current_name") or ""))
            return
        if self.kind == "save":
            p = paths[0]
            if not os.path.isdir(os.path.dirname(p)):
                self.xp_msgbox(title, t("pathNotFound", "%s\nO caminho não existe.").replace("%s", p))
                return
            if os.path.exists(p):
                text = t("replace", "%s já existe.\nDeseja substituí-lo?").replace("%s", os.path.basename(p))
                if self.xp_msgbox(title, text, "warning", ("yes", "no")) != 0:
                    return
            self.finish(0, [Gio.File.new_for_path(p).get_uri()])
            return
        for p in paths:
            if not os.path.exists(p):
                self.xp_msgbox(title, t("notFound", "%s\nNão é possível localizar este ficheiro.")
                               .replace("%s", os.path.basename(p)))
                return
        self.finish(0, [Gio.File.new_for_path(p).get_uri() for p in paths])

    def finish(self, response, uris=None):
        if self._finished:
            return
        self.finish_edit(False)
        self._finished = True
        self._save_state()
        results = {}
        if response == 0:
            results["uris"] = GLib.Variant("as", uris or [])
            flt = self.current_filter()
            if flt:
                results["current_filter"] = GLib.Variant("(sa(us))", (flt[0], [tuple(x) for x in flt[1]]))
            if self.choices:
                ch = []
                for cid, (kind, w) in self.choices.items():
                    ch.append((cid, (w.get_active_id() or "") if kind == "combo" else ("true" if w.get_active() else "false")))
                results["choices"] = GLib.Variant("a(ss)", ch)
            results["writable"] = GLib.Variant("b", True)
        self.hide()
        self.on_done(response, results)
        self.destroy()


class XpBrowseFolder(Gtk.Window):
    """XP's "Browse for Folder" (SHBrowseForFolder with BIF_NEWDIALOGSTYLE and
    BIF_EDITBOX; shell32, dialog 1087), for choosing folders (the "Open
    Folder" of editors and IDEs, SaveFiles): the application's text at the
    top, the tree from the Desktop (dotted lines, +/-), "Pasta:", "Criar nova
    pasta" (with the name edited in the tree), OK / Cancel and the grip in
    the corner."""
    # (what is the same as in the file dialog)
    _measure = XpFileDialog._measure
    _modal = XpFileDialog._modal
    _msg_label = XpFileDialog._msg_label
    xp_msgbox = XpFileDialog.xp_msgbox
    _set_transient = XpFileDialog._set_transient
    _clamp_grow = XpFileDialog._clamp_grow
    _grip_press = XpFileDialog._grip_press
    _grip_motion = XpFileDialog._grip_motion
    _load_state = staticmethod(XpFileDialog._load_state)

    COLS = (GdkPixbuf.Pixbuf, str, str, bool)      # icon, name, path, already read

    def __init__(self, kind, title, options, on_done, parent_window=""):
        super().__init__(title=t("browseTitle", "Procurar pasta"))
        self.kind, self.options, self.on_done = kind, options, on_done
        self._finished = False
        self._wcache = {}
        self._parent_window = parent_window
        self._grip = None
        self._editing = None
        self.state = self._load_state()
        self.set_modal(bool(options.get("modal", True)))
        self.set_type_hint(Gdk.WindowTypeHint.DIALOG)
        self.set_position(Gtk.WindowPosition.CENTER)
        self.set_resizable(False)
        self.connect("delete-event", lambda *_: self.finish(1) or True)
        self.connect("key-press-event", self._on_key)
        self.connect("realize", self._set_transient)
        prov = Gtk.CssProvider()
        prov.load_from_data(CSS.encode())
        Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(), prov,
                                                 Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        lay = load("layout-browse.json", {"size": [318, 288], "controls": {}})
        bw, bh = lay["size"]
        c = {int(k): v for k, v in lay["controls"].items()}
        self.box = AnchorFixed(bw, bh)
        self.add(self.box)

        # the text the application set (lpszTitle), up to 3 lines
        r = c.get(14146, [15, 11, 288, 39])
        desc = self._msg_label(xp_wrap(title or "", r[2], lambda s: self._measure(self, s), 3))
        self.box.place(desc, r, "lt", "w")

        self.store = Gtk.TreeStore(*self.COLS)
        self.tree = Gtk.TreeView(model=self.store, headers_visible=False)
        self.tree.get_style_context().add_class("zxp-browse")
        self.tree.set_enable_tree_lines(True)
        col = Gtk.TreeViewColumn()
        cp = Gtk.CellRendererPixbuf(xpad=0, ypad=0)
        col.pack_start(cp, False)
        col.add_attribute(cp, "pixbuf", 0)
        # (without stretching: the highlight stays on the name only, as in XP)
        self.name_cell = TreeNameCell(self)
        col.pack_start(self.name_cell, False)
        col.add_attribute(self.name_cell, "text", 1)
        self.name_col = col
        self.tree.append_column(col)
        self.tree.set_expander_column(col)
        self.tree.connect("row-expanded", lambda tv, it, p: self._load(it))
        self.tree.connect("focus-in-event", lambda *_: self.tree.queue_draw())
