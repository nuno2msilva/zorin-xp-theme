    # ------------------------------------------------------------ tree
    def _subfolders(self, path):
        try:
            names = os.listdir(path)
        except OSError:
            return []
        try:
            with open(os.path.join(path, ".hidden"), encoding="utf-8") as f:
                hidden = set(f.read().splitlines())
        except OSError:
            hidden = set()
        out = [(n, os.path.join(path, n)) for n in names
               if not n.startswith(".") and n not in hidden and os.path.isdir(os.path.join(path, n))]
        out.sort(key=lambda x: locale.strxfrm(x[0].lower()))
        return out

    @staticmethod
    def _has_subfolders(path):
        try:
            with os.scandir(path) as it:
                for i, d in enumerate(it):
                    if i > 400:
                        return True         # (huge folders: the + stays, as in XP)
                    if not d.name.startswith(".") and d.is_dir():
                        return True
        except OSError:
            pass
        return False

    def _add(self, parent, path, name, icon=None, lazy=True):
        pb = icon or file_icon(path, True, None, 16)
        it = self.store.append(parent, [pb, name, path, False])
        if lazy and self._has_subfolders(path) or path == HOME:
            self.store.append(it, [None, "", "", True])      # (o +)
        return it

    def _load(self, it):
        if self.store[it][3]:
            return
        self.store[it][3] = True
        path = self.store[it][2]
        child = self.store.iter_children(it)
        while child is not None:
            if not self.store[child][2]:
                self.store.remove(child)
                break
            child = self.store.iter_next(child)
        skip = (DESKTOP, DOCUMENTS) if path == HOME else ()
        for name, p in self._subfolders(path):
            if p not in skip:
                self._add(it, p, name)
        if path == HOME:
            # o disco e as unidades ligadas, como as unidades do XP
            self._add(it, "/", place_name("/"))
            for m in Gio.VolumeMonitor.get().get_mounts():
                root = m.get_root().get_path()
                if root and root != "/":
                    info = ICONS.lookup_by_gicon(m.get_icon(), 16, Gtk.IconLookupFlags.FORCE_SIZE)
                    self._add(it, root, m.get_name(), info.load_icon() if info else None)

    def _children(self, it):
        child = self.store.iter_children(it)
        while child is not None:
            yield child
            child = self.store.iter_next(child)

    def select_folder(self, path):
        """Opens the tree down to the folder (from the closest place)."""
        path = os.path.abspath(path)
        self._load(self.computer)
        anchors = [(DESKTOP, self.root), (DOCUMENTS, self.docs), (HOME, self.computer)]
        anchors += [(self.store[ch][2], ch) for ch in self._children(self.computer)
                    if self.store[ch][2] and not self.store[ch][2].startswith(HOME + os.sep)]
        best = None
        for p, it in anchors:
            if path == p or path.startswith(p.rstrip(os.sep) + os.sep):
                if best is None or len(p) > len(best[0]):
                    best = (p, it)
        if best is None:
            best = (DOCUMENTS, self.docs)
        cur_path, it = best
        rest = os.path.relpath(path, cur_path).split(os.sep) if path != cur_path else []
        for part in rest:
            if part in (".", ""):
                continue
            self._load(it)
            nxt = next((ch for ch in self._children(it) if self.store[ch][2] == os.path.join(cur_path, part)), None)
            if nxt is None:
                break
            self.tree.expand_to_path(self.store.get_path(it))
            cur_path, it = os.path.join(cur_path, part), nxt
        tp = self.store.get_path(it)
        if tp.get_depth() > 1:
            parent = tp.copy()
            parent.up()
            self.tree.expand_to_path(parent)
        self.tree.get_selection().select_path(tp)
        self.tree.set_cursor(tp, None, False)
        self.tree.scroll_to_cell(tp, None, True, 0.5, 0)

    def selected_path(self):
        model, it = self.tree.get_selection().get_selected()
        return (model[it][2], it) if it is not None else (None, None)

    def _on_select(self):
        path, it = self.selected_path()
        if it is not None:
            self.folder.set_text(self.store[it][1])
            self.btn_new.set_sensitive(bool(path) and os.access(path, os.W_OK))
        self.tree.queue_draw()

    # ------------------------------------------------------------ new folder
    def new_folder(self):
        path, it = self.selected_path()
        if not path or not os.access(path, os.W_OK):
            return
        base = t("newFolder", "Nova pasta")
        name, n = base, 2
        while os.path.lexists(os.path.join(path, name)):
            name, n = f"{base} ({n})", n + 1
        new = os.path.join(path, name)
        self._load(it)                  # (before creating it: otherwise it appeared twice)
        try:
            os.mkdir(new)
        except OSError as err:
            self.xp_msgbox(self.get_title(), err.strerror or str(err), "error")
            return
        child = self._add(it, new, name)
        tp = self.store.get_path(child)
        self.tree.expand_to_path(self.store.get_path(it))
        self.tree.get_selection().select_path(tp)
        self.tree.set_cursor(tp, None, False)
        self.tree.scroll_to_cell(tp, None, False, 0, 0)
        GLib.timeout_add(50, lambda: self._start_edit(tp))

    def editing_text_hidden(self, text):
        """(the name of the item being edited is not drawn: the box sits on top)"""
        return self._editing is not None and self._editing.get("text") == text

    def _start_edit(self, tp, text=None):
        """The name edited in place, in the tree (as in XP): a one-line box, tight
        against the name, which grows while typing."""
        self._end_edit(False)
        it = self.store.get_iter(tp)
        name = self.store[it][1]
        ent = Gtk.Entry()
        ent.set_text(name if text is None else text)
        ent.get_style_context().add_class("zxp-rename")
        ent.get_style_context().add_class("zxp-rename-list")
        holder = Gtk.EventBox()
        holder.set_visible_window(True)
        holder.add(ent)
        holder.connect("realize", lambda w: w.get_window().raise_())
        self._editing = {"ref": Gtk.TreeRowReference.new(self.store, tp), "entry": ent, "holder": holder,
                         "text": name, "since": time.monotonic()}
        ent.connect("changed", lambda *_: self._place_edit())
        ent.connect("activate", lambda *_: self._end_edit(True))
        ent.connect("key-press-event", self._edit_key)
        ent.connect("focus-out-event", self._edit_focus_out)
        self.box.put(holder, 0, 0)
        self.box.editor = (holder, [0, 0, 1, 1])
        self._place_edit()
        holder.show_all()
        ent.grab_focus()
        ent.select_region(0, -1)
        self._editing["timer"] = GLib.timeout_add(50, lambda: self._editing is not None and (self._place_edit() or True))
        self.tree.queue_draw()
        return False

    def _place_edit(self):
        ed = self._editing
        if not ed or not ed["ref"].valid():
            return
        tp = ed["ref"].get_path()
        cell = self.tree.get_cell_area(tp, self.name_col)
        bg = self.tree.get_background_area(tp, self.name_col)
        off = self.name_col.cell_get_position(self.name_cell)
        x0 = cell.x + (off[0] if off else 0) + 2          # (the text, after the xpad)
        wx, wy = self.tree.convert_bin_window_to_widget_coords(x0, bg.y)
        co = self.tree.translate_coordinates(self.box, wx, wy)
        if co is None:
            return
        tw = self._measure(self, ed["entry"].get_text())
        w = tw + 2 + 15 + 2
        rect = [co[0] - 2 - 1, co[1] + (bg.height - 17) // 2, w, 17]
        if self.box.editor and self.box.editor[1] != rect:
            self.box.editor = (ed["holder"], rect)
            self.box.queue_resize()

    def _edit_key(self, _w, ev):
        if ev.keyval == Gdk.KEY_Escape:
            self._end_edit(False)
            return True
        return False

    def _edit_focus_out(self, *_):
        ed = self._editing
        if ed is None:
            return False
        if time.monotonic() - ed["since"] < 0.4:
            GLib.idle_add(lambda: self._editing is ed and ed["entry"].grab_focus() and False)
            return False
        GLib.idle_add(lambda: self._editing is ed and self._end_edit(True))
        return False

    def _end_edit(self, commit=False):
        ed, self._editing = self._editing, None
        if ed is None:
            return
        GLib.source_remove(ed["timer"]) if ed.get("timer") else None
        text = ed["entry"].get_text()
        self.box.editor = None
        ed["holder"].destroy()
        self.tree.grab_focus()
        self.tree.queue_draw()
        if commit and ed["ref"].valid():
            GLib.idle_add(lambda: self._rename(ed["ref"], text) and False)

    def _rename(self, ref, text):
        it = self.store.get_iter(ref.get_path())
        old = self.store[it][2]
        new = text.replace("\n", " ").strip()
        if not new or new == os.path.basename(old):
            return
        title = t("renameError", "Erro ao mudar o nome a ficheiro ou pasta")
        target = os.path.join(os.path.dirname(old), new)
        if "/" in new or new in (".", ".."):
            self.xp_msgbox(title, t("badChars"), "error")
            self._start_edit(ref.get_path(), new)
            return
        if os.path.lexists(target) and not os.path.samefile(target, old):
            self.xp_msgbox(title, fmt(t("renameFailed"), t("nameExists"), os.path.basename(old)), "error")
            self._start_edit(ref.get_path(), new)
            return
        try:
            os.rename(old, target)
        except OSError as err:
            self.xp_msgbox(title, fmt(t("renameFailed"), err.strerror or str(err), os.path.basename(old)), "error")
            return
        self.store[it][1], self.store[it][2] = new, target
        self._on_select()

    # ------------------------------------------------------------ resposta
    def _on_key(self, _w, ev):
        if self._editing is not None:
            return False
        if ev.keyval == Gdk.KEY_Escape:
            self.finish(1)
            return True
        if ev.keyval == Gdk.KEY_F2 and self.tree.has_focus():
            path, it = self.selected_path()
            if path and it is not None and self.store.iter_parent(it) is not None and \
                    os.access(os.path.dirname(path), os.W_OK) and path not in PLACES:
                self._start_edit(self.store.get_path(it))
            return True
        return False

    def accept(self):
        self._end_edit(True)
        path, it = self.selected_path()
        text = self.folder.get_text().strip()
        if it is not None and text and text != self.store[it][1]:
            cand = os.path.expanduser(text)
            cand = cand if os.path.isabs(cand) else os.path.join(path or HOME, cand)
            if not os.path.isdir(cand):
                self.xp_msgbox(self.get_title(), t("pathNotFound", "%s\nO caminho não existe.").replace("%s", cand))
                return
            path = cand
        if not path or not os.path.isdir(path):
            return
        if self.kind == "savefiles":
            files = [bytes(f).rstrip(b"\0").decode("utf-8", "replace") for f in self.options.get("files") or []]
            uris = [Gio.File.new_for_path(os.path.join(path, os.path.basename(f))).get_uri() for f in files]
        else:
            uris = [Gio.File.new_for_path(path).get_uri()]
        self.finish(0, uris)

    def finish(self, response, uris=None):
        if self._finished:
            return
        self._end_edit(False)
        self._finished = True
        self.state = self._load_state()
        self.state["browseSize"] = [self.box.base[0] + self.box.grow[0], self.box.base[1] + self.box.grow[1]]
        try:
            os.makedirs(os.path.dirname(STATE_FILE), exist_ok=True)
            tmp = STATE_FILE + ".tmp"
            with open(tmp, "w", encoding="utf-8") as f:
                json.dump(self.state, f)
            os.replace(tmp, STATE_FILE)
        except OSError:
            pass
        results = {}
        if response == 0:
            results["uris"] = GLib.Variant("as", uris or [])
            results["writable"] = GLib.Variant("b", True)
        self.hide()
        self.on_done(response, results)
        self.destroy()


def load_thumb(e):
    """XP's thumbnail: the image scaled down to fit 96 x 96 (small ones do not
    grow); for other types, the thumbnail GNOME already made."""
    path = None
    try:
        info = Gio.File.new_for_path(e.path).query_info("thumbnail::path", Gio.FileQueryInfoFlags.NONE, None)
        path = info.get_attribute_byte_string("thumbnail::path")
    except GLib.Error:
        pass
    src = path or (e.path if (e.ctype or "").startswith("image/") else None)
    if not src:
        return None
    try:
        fmt_, w, h = GdkPixbuf.Pixbuf.get_file_info(src)
        if fmt_ is None or w <= 0 or h <= 0:
            return None
        if w * h > 4_000_000:
            pb = GdkPixbuf.Pixbuf.new_from_file_at_scale(src, 96, 96, True)
        else:
            pb = GdkPixbuf.Pixbuf.new_from_file(src)
        pb = pb.apply_embedded_orientation() or pb
        w, h = pb.get_width(), pb.get_height()
        if w > 96 or h > 96:
            k = min(96 / w, 96 / h)
            pb = pb.scale_simple(max(1, round(w * k)), max(1, round(h * k)), GdkPixbuf.InterpType.HYPER)
        return pb
    except (GLib.Error, TypeError):
        return None


# ---------------------------------------------------------------- portal
class Portal:
    def __init__(self, loop):
        self.loop = loop
        self.active = 0
        self.conn = None
        self._idle = 0

    def start(self):
        Gio.bus_own_name(Gio.BusType.SESSION, BUS_NAME, Gio.BusNameOwnerFlags.NONE,
                         self._on_bus, None, lambda *_: self.loop.quit())

    def _on_bus(self, conn, _name):
        self.conn = conn
        node = Gio.DBusNodeInfo.new_for_xml(IFACE)
        conn.register_object(OBJ_PATH, node.interfaces[0], self._on_call, None, None)
        self._arm_idle()

    def _arm_idle(self):
        if self._idle:
            GLib.source_remove(self._idle)
        self._idle = GLib.timeout_add_seconds(IDLE_EXIT_S, self._maybe_exit)

    def _maybe_exit(self):
        self._idle = 0
        if not self.active:
            self.loop.quit()
            return False
        self._arm_idle()
        return False

    def _on_call(self, conn, sender, path, iface, method, params, inv):
        handle, app_id, parent, title, options = params.unpack()
        kind = {"OpenFile": "open", "SaveFile": "save", "SaveFiles": "savefiles"}[method]
        try:
            self._show(kind, handle, parent, title, options, inv)
        except Exception as e:      # GNOME's dialog instead of this one
            print(f"zorin-xp-filechooser: {e}; a usar a do GNOME", file=sys.stderr)
            self._fallback(method, params, inv)

    def _fallback(self, method, params, inv):
        def done(conn, res):
            try:
                inv.return_value(conn.call_finish(res))
            except GLib.Error as e:
                inv.return_gerror(e)
        self.conn.call(FALLBACK, OBJ_PATH, "org.freedesktop.impl.portal.FileChooser", method, params,
                       GLib.VariantType("(ua{sv})"), Gio.DBusCallFlags.NONE, -1, None, done)

    def _show(self, kind, handle, parent, title, options, inv):
        reg = [0]
        dialog = [None]

        def done(response, results):
            self.active -= 1
            if reg[0]:
                self.conn.unregister_object(reg[0])
                reg[0] = 0
            inv.return_value(GLib.Variant("(ua{sv})", (response, results)))
            self._arm_idle()

        def on_request(conn, sender, path, iface, method, params, rinv):
            rinv.return_value(None)
            if dialog[0]:
                dialog[0].finish(2)

        req = Gio.DBusNodeInfo.new_for_xml(REQUEST)
        try:
            reg[0] = self.conn.register_object(handle, req.interfaces[0], on_request, None, None)
        except GLib.Error:
            reg[0] = 0
        self.active += 1
        try:
            cls = XpBrowseFolder if kind == "savefiles" or options.get("directory") else XpFileDialog
            dialog[0] = cls(kind, title, options, done, parent)
        except Exception:
            self.active -= 1
            if reg[0]:
                self.conn.unregister_object(reg[0])
            raise
        dialog[0].present()


def shot(widget, path):
    """(test) Draws a window's content into a PNG, without the screen."""
    child = widget.get_child() if isinstance(widget, Gtk.Window) else widget
    a = child.get_allocation()
    surf = cairo.ImageSurface(cairo.FORMAT_ARGB32, a.width, a.height)
    cr = cairo.Context(surf)
    cr.set_source_rgb(*rgb(FACE))
    cr.paint()
    child.draw(cr)
    surf.write_to_png(path)


def main():
    try:
        locale.setlocale(locale.LC_ALL, "")
    except locale.Error:
        pass
    if len(sys.argv) >= 3 and sys.argv[1] == "--test":
        kind = {"open": "open", "save": "save", "folder": "open", "multi": "open"}[sys.argv[2]]
        opts = {"filters": [("Imagens", [(1, "image/*")]), ("Todos os ficheiros", [(0, "*")])],
                "current_name": "sem título.png" if kind == "save" else "",
                "directory": sys.argv[2] == "folder", "multiple": sys.argv[2] == "multi"}
        if len(sys.argv) > 3 and sys.argv[3]:
            opts["current_folder"] = sys.argv[3].encode() + b"\0"

        def done(r, res):
            print(r, {k: v.unpack() for k, v in res.items()})
            Gtk.main_quit()
        global TEST
        TEST = True
        # (outside the session there are no GNOME settings: the XP theme's)
        st = Gtk.Settings.get_default()
        st.set_property("gtk-icon-theme-name", "WindowsXP")
        st.set_property("gtk-font-name", "Tahoma 8.25")
        global ICONS
        ICONS = Gtk.IconTheme.get_default()
        _icon_cache.clear()
        if opts["directory"]:
            dlg = XpBrowseFolder(kind, os.environ.get("ZXP_FC_TITLE", "Seleccione uma pasta:"), opts, done)
        else:
            dlg = XpFileDialog(kind, "", opts, done)
        if len(sys.argv) > 4:
            # (test: types the name and presses the button)

            global TEST_REPLY
            TEST_REPLY = True

            def go():
                dlg.entry.set_text(sys.argv[4])
                dlg.accept()
                return False
            GLib.timeout_add(2000, go)
        script = os.environ.get("ZXP_FC_SCRIPT")
        if script:
            with open(script, encoding="utf-8") as f:
                code = f.read()
            GLib.timeout_add(500, lambda: exec(code, {"dlg": dlg, "Gtk": Gtk, "Gdk": Gdk, "GLib": GLib,
                                                      "shot": shot, "os": os}) and False)
        Gtk.main()
        return
    loop = GLib.MainLoop()
    Portal(loop).start()
    loop.run()


if __name__ == "__main__":
