class TreeNameCell(Gtk.CellRendererText):
    """The name in the "Browse for Folder" tree: the highlight only on the
    text (GTK does not paint the background of selected cells), blue with
    the focus, beige without."""

    def __init__(self, dlg):
        super().__init__(xpad=2, ypad=1)
        self.dlg = dlg

    def do_render(self, cr, widget, background_area, cell_area, flags):
        hidden = self.dlg.editing_text_hidden(self.props.text)
        selected = bool(flags & Gtk.CellRendererState.SELECTED)
        focus = self.dlg.get_focus() is widget and (self.dlg.is_active() or TEST)
        if selected and not hidden:
            cr.set_source_rgb(*rgb(HIGHLIGHT if focus else FACE))
            w = self.dlg._measure(widget, self.props.text or "") + 2 * self.props.xpad
            cr.rectangle(cell_area.x, background_area.y + 1, min(w, cell_area.width), background_area.height - 2)
            cr.fill()
        self.set_property("foreground-rgba", Gdk.RGBA(1, 1, 1, 1) if selected and focus else Gdk.RGBA(0, 0, 0, 1))
        if not hidden:
            Gtk.CellRendererText.do_render(self, cr, widget, background_area, cell_area,
                                           Gtk.CellRendererState(int(flags) & ~int(Gtk.CellRendererState.SELECTED)))


class AnchorFixed(Gtk.Fixed):
    """Positions from the dialog template, with XP's anchoring on resize: the
    list stretches, the bottom row follows the bottom, the buttons the right
    edge. The size is the template's plus what the corner grip added (grow);
    the box of the name being edited goes on top of everything (editor)."""

    def __init__(self, base_w, base_h):
        super().__init__()
        self.base = (base_w, base_h)
        self.grow = [0, 0]
        self.items = []          # (widget, (x, y, w, h), anchors "lrtb", stretch "wh")
        self.editor = None       # (widget, [x, y, w, h])

    def place(self, widget, rect, anchor="lt", stretch=""):
        self.put(widget, rect[0], rect[1])
        self.items.append((widget, rect, anchor, stretch))

    # (in XP the template's size is also the minimum)
    def do_get_preferred_width(self):
        w = self.base[0] + self.grow[0]
        return w, w

    def do_get_preferred_height(self):
        h = self.base[1] + self.grow[1]
        return h, h

    def do_size_allocate(self, alloc):
        self.set_allocation(alloc)
        dw = alloc.width - self.base[0]
        dh = alloc.height - self.base[1]
        for w, (x, y, cw, ch), anchor, stretch in self.items:
            if not w.get_visible():
                continue
            nx = x + (dw if "r" in anchor and "l" not in anchor else 0)
            ny = y + (dh if "b" in anchor and "t" not in anchor else 0)
            nw = cw + (dw if "w" in stretch else 0)
            nh = ch + (dh if "h" in stretch else 0)
            _min, nat = w.get_preferred_height_for_width(max(1, nw)) if ch <= 0 else (0, nh)
            r = Gdk.Rectangle()
            r.x, r.y, r.width, r.height = alloc.x + nx, alloc.y + ny, max(1, nw), max(1, nat if ch <= 0 else nh)
            w.size_allocate(r)
        if self.editor:
            w, (x, y, cw, ch) = self.editor
            w.get_preferred_width()     # (GTK wants the request before the allocation)
            r = Gdk.Rectangle()
            r.x, r.y, r.width, r.height = alloc.x + x, alloc.y + y, max(1, cw), max(1, ch)
            w.size_allocate(r)


