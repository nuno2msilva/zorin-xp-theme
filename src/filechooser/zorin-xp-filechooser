def sort_entries(entries, key, desc):
    def k(e):
        name = locale.strxfrm(e.name.lower())
        if key == "size":
            return (0 if e.is_dir else e.size, name)
        if key == "type":
            return (locale.strxfrm(e.type_name().lower()), name)
        if key == "mtime":
            return (e.mtime, name)
        return (name,)
    dirs = sorted((e for e in entries if e.is_dir), key=k, reverse=desc)
    files = sorted((e for e in entries if not e.is_dir), key=k, reverse=desc)
    return dirs + files


def matches(entry, flt):
    """flt: (name, [(0, glob) | (1, mime)]) — folders always show."""
    if entry.is_dir or not flt:
        return True
    for kind, pat in flt[1]:
        if kind == 0 and fnmatch.fnmatch(entry.name.lower(), pat.lower()):
            return True
        if kind == 1 and entry.ctype and Gio.content_type_is_a(entry.ctype, Gio.content_type_from_mime_type(pat) or pat):
            return True
    return False


def xp_wrap(text, width, measure, lines=2):
    """text in up to `lines` lines of `width` px, like XP's DrawText with
    DT_WORDBREAK | DT_END_ELLIPSIS: breaks at spaces; a word wider than the
    line is cut with "..." and ends there; the last line takes the rest of
    the text, cut at the end. lines=None: the whole text (the focused item's
    name in XP), with long words broken where the line ends."""
    if measure(text) <= width:
        return text

    def fits(s):                        # the longest start of s that fits (>= 1)
        lo, hi = 1, len(s)
        while lo < hi:
            mid = (lo + hi + 1) // 2
            if measure(s[:mid]) <= width:
                lo = mid
            else:
                hi = mid - 1
        return lo

    def cut(s):
        if measure(s) <= width:
            return s
        lo, hi = 0, len(s)
        while lo < hi:                  # the longest start that fits with "..."
            mid = (lo + hi + 1) // 2
            if measure(s[:mid].rstrip() + "...") <= width:
                lo = mid
            else:
                hi = mid - 1
        return s[:lo].rstrip() + "..."
    out = []
    rest = text
    while rest and (lines is None or len(out) < lines):
        if lines is not None and len(out) == lines - 1:
            out.append(cut(rest))
            break
        words = rest.split(" ")
        line = words[0]
        if measure(line) > width:
            if lines is None:
                n = fits(line)
                out.append(line[:n])
                rest = rest[n:]
                continue
            out.append(cut(line))
            break
        i = 1
        while i < len(words) and measure(line + " " + words[i]) <= width:
            line += " " + words[i]
            i += 1
        out.append(line)
        rest = " ".join(words[i:])
    return "\n".join(out)


def play_sound(file=None, event=None):
    """A sound from XP's scheme, if event sounds are on."""
    try:
        if not Gio.Settings.new("org.gnome.desktop.sound").get_boolean("event-sounds"):
            return
    except Exception:
        return
    args = ["canberra-gtk-play"] + (["-f", file] if file else ["-i", event])
    if file and not os.path.exists(file):
        return
    try:
        GLib.spawn_async(args, flags=GLib.SpawnFlags.SEARCH_PATH | GLib.SpawnFlags.STDOUT_TO_DEV_NULL |
                         GLib.SpawnFlags.STDERR_TO_DEV_NULL)
    except GLib.Error:
        pass


