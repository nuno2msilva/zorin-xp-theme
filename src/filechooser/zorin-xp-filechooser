def draw_text(cr, widget, text, x, top, color):
    lay = widget.create_pango_layout(text)
    cr.set_source_rgb(*rgb(color))
    cr.move_to(x, top + ASCENT - lay.get_baseline() // Pango.SCALE)
    PangoCairo.show_layout(cr, lay)


def line_attrs():
    attrs = Pango.AttrList()
    attrs.insert(Pango.attr_line_height_new_absolute(LINE * Pango.SCALE))
    return attrs


