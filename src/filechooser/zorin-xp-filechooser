class ItemCell(Gtk.CellRenderer):
    """An item in Thumbnails, Tiles or Icons, drawn as in XP."""
    entry = GObject.Property(type=object)

    def __init__(self, dlg):
        super().__init__()
        self.dlg = dlg

    def do_get_request_mode(self):
        return Gtk.SizeRequestMode.CONSTANT_SIZE

    def do_get_preferred_width(self, widget):
        w = GRID.get(self.dlg.view_mode, (75, 75))[0]
        return w, w

    def do_get_preferred_height(self, widget):
        h = GRID.get(self.dlg.view_mode, (75, 75))[1]
        return h, h

    def do_get_preferred_height_for_width(self, widget, width):
        return self.do_get_preferred_height(widget)

    def do_get_preferred_width_for_height(self, widget, height):
        return self.do_get_preferred_width(widget)

    def do_render(self, cr, widget, background_area, cell_area, flags):
        self.dlg.draw_item(cr, widget, cell_area, self.props.entry,
                           bool(flags & Gtk.CellRendererState.SELECTED))


