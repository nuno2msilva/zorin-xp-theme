def place_name(path):
    names = {DOWNLOADS: os.path.basename(DOWNLOADS), PICTURES: t("pictures", "As minhas imagens")}
    names.update({DESKTOP: t("desktop", "Ambiente de trabalho"), DOCUMENTS: t("documents", "Os meus documentos"),
                  HOME: t("computer", "O meu computador"), NETWORK: t("network", "Os meus locais na rede"),
                  "/": t("localDisk", "Disco local")})
    return names.get(path)


def place_icon(path):
    icons = {DOWNLOADS: "folder-download", PICTURES: "folder-pictures"}
    icons.update({DESKTOP: "user-desktop", DOCUMENTS: "folder-documents", HOME: "user-home",
                  NETWORK: "network-workgroup", "/": "drive-harddisk"})
    return icons.get(path)


def host_path(path):
    """The document portal's paths (/run/user/N/doc/<id>/...), which is what
    flatpak applications (Zen) know, -> the real path. The <id> folder only
    contains the exported file: it matches that file's folder."""
    root = os.path.join(GLib.get_user_runtime_dir(), "doc") + os.sep
    if not path or not path.startswith(root):
        return path
    parts = path[len(root):].split(os.sep)
    if parts[0] == "by-app" and len(parts) >= 3:
        parts = parts[2:]
    doc_id, tail = parts[0], os.sep.join(parts[1:])
    try:
        bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)
        res = bus.call_sync("org.freedesktop.portal.Documents", "/org/freedesktop/portal/documents",
                            "org.freedesktop.portal.Documents", "Info", GLib.Variant("(s)", (doc_id,)),
                            GLib.VariantType("(aya{sas})"), Gio.DBusCallFlags.NONE, 2000, None)
        host = bytes(res.unpack()[0]).rstrip(b"\0").decode("utf-8", "replace")
    except (GLib.Error, TypeError, ValueError):
        return path
    if not host:
        return path
    return os.path.join(os.path.dirname(host), tail) if tail else os.path.dirname(host)


ICONS = Gtk.IconTheme.get_default()
_icon_cache = {}
_blend_cache = {}


def icon_pixbuf(names, size):
    if isinstance(names, str):
        names = [names]
    key = (tuple(names), size)
    if key not in _icon_cache:
        info = ICONS.choose_icon(list(names) + ["text-x-generic"], size, Gtk.IconLookupFlags.FORCE_SIZE)
        _icon_cache[key] = info.load_icon() if info else None
    return _icon_cache[key]


def file_icon(path, is_dir, ctype, size):
    if is_dir:
        pi = place_icon(path)
        if pi:
            return icon_pixbuf(pi, size)
        for kind, name in ((GLib.UserDirectory.DIRECTORY_PICTURES, "folder-pictures"),
                           (GLib.UserDirectory.DIRECTORY_MUSIC, "folder-music"),
                           (GLib.UserDirectory.DIRECTORY_VIDEOS, "folder-videos"),
                           (GLib.UserDirectory.DIRECTORY_DOWNLOAD, "folder-download")):
            if special(kind) == path:
                return icon_pixbuf(name, size)
        return icon_pixbuf("folder", size)
    icon = Gio.content_type_get_icon(ctype or "application/octet-stream")
    names = icon.get_names() if isinstance(icon, Gio.ThemedIcon) else []
    return icon_pixbuf(names + ["unknown"], size)


# selection as in XP (ImageList ILD_BLEND50, measured in an XP capture):
# pixels with alpha >= 128 go halfway to the highlight colour, in
# premultiplied alpha and rounded up (it may exceed the alpha: drawing
# saturates, as in XP); the others (shadows) stay the same
HIGHLIGHT = (0x31, 0x6A, 0xC5)
FACE = (0xEC, 0xE9, 0xD8)
GREY = (0x80, 0x80, 0x80)
SORTED_BG = (0xF7, 0xF7, 0xF7)        # the column the list is sorted by (Details)


def rgb(c):
    return c[0] / 255, c[1] / 255, c[2] / 255


def blended(pb):
    """The image of the selected icon (cairo, premultiplied)."""
    if pb is None:
        return None
    hit = _blend_cache.get(pb)
    if hit is not None:
        return hit[0]
    if not pb.get_has_alpha():
        pb = pb.add_alpha(False, 0, 0, 0)
    w, h, rs = pb.get_width(), pb.get_height(), pb.get_rowstride()
    src = pb.get_pixels()
    stride = cairo.ImageSurface.format_stride_for_width(cairo.FORMAT_ARGB32, w)
    out = bytearray(stride * h)
    hr, hg, hb = HIGHLIGHT
    for y in range(h):
        for x in range(w):
            i = y * rs + x * 4
            r, g, b, a = src[i], src[i + 1], src[i + 2], src[i + 3]
            r, g, b = (r * a + 127) // 255, (g * a + 127) // 255, (b * a + 127) // 255
            if a >= 128:
                r, g, b = (r + hr + 1) >> 1, (g + hg + 1) >> 1, (b + hb + 1) >> 1
            o = y * stride + x * 4
            out[o], out[o + 1], out[o + 2], out[o + 3] = b, g, r, a
    s = cairo.ImageSurface.create_for_data(out, cairo.FORMAT_ARGB32, w, h, stride)
    _blend_cache[pb] = (s, out)         # (the data must live with the image)
    return s


def human_size(n):
    kb = max(1, (n + 1023) // 1024) if n else 0
    return t("kb", "%s KB").replace("%s", f"{kb:,}".replace(",", "."))


class Entry:
    __slots__ = ("name", "path", "is_dir", "ctype", "size", "mtime", "cache")

    def __init__(self, name, path, is_dir, ctype, size, mtime):
        self.name, self.path, self.is_dir, self.ctype, self.size, self.mtime = name, path, is_dir, ctype, size, mtime
        self.cache = {}

    def icon(self, size):
        key = ("icon", size)
        if key not in self.cache:
            self.cache[key] = file_icon(self.path, self.is_dir, self.ctype, size)
        return self.cache[key]

    def type_name(self):
        if self.is_dir:
            return t("folderType", "Pasta de ficheiros")
        if "type" not in self.cache:
            text = Gio.content_type_get_description(self.ctype) if self.ctype else ""
            self.cache["type"] = text[:1].upper() + text[1:]
        return self.cache["type"]


def make_entry(path):
    try:
        st = os.stat(path)
    except OSError:
        return None
    name = os.path.basename(path)
    is_dir = os.path.isdir(path)
    ctype = None if is_dir else Gio.content_type_guess(name, None)[0]
    return Entry(name, path, is_dir, ctype, st.st_size, st.st_mtime)


def list_dir(path, show_hidden=False):
    try:
        names = os.listdir(path)
    except OSError:
        return []
    # ~/.hidden: the names Files also hides (e.g. the shortcuts with the home
    # folders' old names)
    try:
        with open(os.path.join(path, ".hidden"), encoding="utf-8") as f:
            hidden = set(f.read().splitlines())
    except OSError:
        hidden = set()
    out = []
    for name in names:
        if (name.startswith(".") or name in hidden) and not show_hidden:
            continue
        e = make_entry(os.path.join(path, name))
        if e:
            out.append(e)
    return out


