def fmt(text, *args):
    """The %1, %2!ls! of Windows strings."""
    return re.sub(r"%(\d)(?:![^!]*!)?", lambda m: str(args[int(m.group(1)) - 1])
                  if int(m.group(1)) <= len(args) else "", text)


def mnemonic(text):
    """'G&uardar em:' -> 'G_uardar em:' (GTK); '&&' -> '&'."""
    return text.replace("_", "__").replace("&&", "\x00").replace("&", "_").replace("\x00", "&")


def plain(text):
    return text.replace("&&", "\x00").replace("&", "").replace("\x00", "&")


