#!/usr/bin/python3
"""Zorin XP — Zorin Appearance as a Windows XP property sheet.

Replaces the `zorin-appearance` command (installed in ~/.local/bin, which
comes before /usr/bin in PATH) and runs Zorin's application without changing
it; it only rearranges the window after the application builds it, like
XP's Display Properties:
  - tabs (Gtk.Notebook) instead of the sidebar (GtkStackSidebar);
  - title on the left on the blue bar;
  - sections (bold title + content) in group boxes (Gtk.Frame, which the
    theme draws with the title embedded in the outline);
  - Close button at the bottom right (changes apply at once, as in the
    original application, so there is no OK/Cancel).
"""
import sys

import gi

gi.require_version('Gtk', '3.0')
from gi.repository import GLib, GObject, Gtk  # noqa: E402

from zorin_appearance import __main__ as za  # noqa: E402

# margins measured on an XP property sheet (the same as the taskbar
# settings): tab at 7/5/6 px, buttons 9 px from it, 6 px from each other and
# from the right, 8 px from the bottom
MARGIN = {'top': 7, 'start': 5, 'end': 6, 'bottom': 9}
BUTTONS = {'end': 6, 'bottom': 8, 'spacing': 6}

TEXTS = {
    'pt': {'close': 'Fechar', 'title': 'Propriedades de aparência', 'settings': 'Definições'},
    'es': {'close': 'Cerrar', 'title': 'Propiedades de apariencia', 'settings': 'Configuración'},
    'fr': {'close': 'Fermer', 'title': "Propriétés de l'apparence", 'settings': 'Paramètres'},
    'de': {'close': 'Schließen', 'title': 'Eigenschaften von Darstellung', 'settings': 'Einstellungen'},
    'en': {'close': 'Close', 'title': 'Appearance Properties', 'settings': 'Settings'},
}
GEAR = 'emblem-system-symbolic'
# list rows: 12 px inner margins in the application, compact in XP
ROW_MARGIN = {'top': 3, 'bottom': 3, 'start': 6, 'end': 6}
LANG = next((l[:2] for l in GLib.get_language_names() if l[:2] in TEXTS), 'en')
T = TEXTS[LANG]


class _StackProxy:
    """What the application still asks of the Gtk.Stack (go to a page)."""

    def __init__(self, notebook, names):
        self._notebook = notebook
        self._names = names

    def set_visible_child_name(self, name):
        if name in self._names:
            self._notebook.set_current_page(self._names.index(name))


def _group_boxes(root):
    """Sections "<b>Title</b>" + content -> XP group box."""
    def walk(widget):
        if isinstance(widget, Gtk.Container):
            for child in widget.get_children():
                walk(child)
        if not isinstance(widget, Gtk.Box):
            return
        children = widget.get_children()
        if len(children) != 2 or not isinstance(children[0], Gtk.Label):
            return
        label, content = children
        markup = label.get_label() or ''
        if not (markup.startswith('<b>') and markup.endswith('</b>')):
            return
        frame = Gtk.Frame(label=label.get_text())
        frame.get_style_context().add_class('zxp-groupbox')
        widget.remove(label)
        widget.remove(content)
        frame.add(content)
        widget.pack_start(frame, True, True, 0)
    walk(root)


def _walk(widget):
    yield widget
    if isinstance(widget, Gtk.Container):
        for child in widget.get_children():
            yield from _walk(child)


def _gear_buttons(root):
    """Gear-only buttons -> a "Definições" (Settings) button, as in XP."""
    for w in list(_walk(root)):
        if not isinstance(w, Gtk.Button):
            continue
        image = w.get_image() or w.get_child()
        if isinstance(image, Gtk.Image) and image.get_icon_name()[0] == GEAR:
            w.set_image(None)
            w.set_always_show_image(False)
            w.set_label(T['settings'])


def _xp_lists(root):
    """The application's lists (white cards with rows) -> loose controls in a
    group box: no frame nor separators, compact rows. Those that are not in a
    section with a title go in a box without a title."""
    for lst in [w for w in _walk(root) if isinstance(w, Gtk.ListBox)]:
        if isinstance(lst.get_parent(), Gtk.FlowBox):
            continue
        lst.set_header_func(None)
        for row in lst.get_children():
            row.set_header(None)
            box = row.get_child()
            if isinstance(box, Gtk.Box):
                box.set_margin_top(ROW_MARGIN['top'])
                box.set_margin_bottom(ROW_MARGIN['bottom'])
                box.set_margin_start(ROW_MARGIN['start'])
                box.set_margin_end(ROW_MARGIN['end'])
        lst.get_style_context().add_class('zxp-plain-list')
        # the application puts each list in a frame (the "card"): inside one of our
        # group boxes it disappears; on its own it becomes a group box without a title
        frames = []
        a = lst.get_parent()
        while a and not isinstance(a, Gtk.Notebook):
            if isinstance(a, Gtk.Frame):
                frames.append(a)
            a = a.get_parent()
        ours = [f for f in frames if f.get_style_context().has_class('zxp-groupbox')]
        theirs = [f for f in frames if f not in ours]
        if theirs:
            if ours:
                for f in theirs:
                    f.set_shadow_type(Gtk.ShadowType.NONE)
                    f.get_style_context().add_class('flat')
            else:
                theirs[0].get_style_context().add_class('zxp-groupbox')
            continue
        if ours:
            continue
        parent = lst.get_parent()
        if not isinstance(parent, Gtk.Box):
            continue
        pos = parent.get_children().index(lst)
        expand, fill, padding, pack = parent.query_child_packing(lst)
        frame = Gtk.Frame()
        frame.get_style_context().add_class('zxp-groupbox')
        parent.remove(lst)
        frame.add(lst)
        parent.pack_start(frame, expand, fill, padding)
        parent.reorder_child(frame, pos)


class XpAppearance(za.ZorinAppearance):

    def __init__(self):
        super().__init__()
        grid = self.get_child()
        stack = self.stack

        notebook = Gtk.Notebook(
            margin_top=MARGIN['top'], margin_bottom=MARGIN['bottom'],
            margin_start=MARGIN['start'], margin_end=MARGIN['end'],
            scrollable=False)
        names = []
        for child in stack.get_children():
            title = stack.child_get_property(child, 'title')
            names.append(stack.child_get_property(child, 'name'))
            stack.remove(child)
            # (the outline is the tab's own)
            if isinstance(child, Gtk.ScrolledWindow):
                child.set_shadow_type(Gtk.ShadowType.NONE)
            notebook.append_page(child, Gtk.Label(label=title))
        _group_boxes(notebook)
        _xp_lists(notebook)
        _gear_buttons(notebook)

        close = Gtk.Button(label=T['close'])
        close.get_style_context().add_class('default')
        close.connect('clicked', lambda _b: self.close())
        buttons = Gtk.Box(halign=Gtk.Align.END, spacing=BUTTONS['spacing'],
                          margin_end=BUTTONS['end'], margin_bottom=BUTTONS['bottom'])
        buttons.pack_start(close, False, False, 0)

        content = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        content.pack_start(notebook, True, True, 0)
        content.pack_start(buttons, False, False, 0)
        self.remove(grid)
        self.add(content)
        self.stack = _StackProxy(notebook, names)

        # title on the left, as in XP's dialogs (GtkHeaderBar centres it)
        hb = self.get_titlebar()
        title = Gtk.Label(xalign=0)
        title.get_style_context().add_class('title')
        self.bind_property('title', title, 'label', GObject.BindingFlags.SYNC_CREATE)
        hb.set_custom_title(Gtk.Box())
        hb.pack_start(title)
        self.get_style_context().add_class('zxp-property-sheet')
        self.connect('notify::title', self._xp_title)

    def _xp_title(self, *_args):
        # the application sets "Aparência do Zorin" after creating the window
        if self.get_title() != T['title']:
            self.set_title(T['title'])


za.ZorinAppearance = XpAppearance

if __name__ == '__main__':
    sys.exit(za.main())
