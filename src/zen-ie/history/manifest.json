{
  "manifest_version": 2,
  "name": "Histórico",
  "description": "A barra Histórico do Internet Explorer 6 (Zorin XP).",
  "version": "1.3",
  "browser_specific_settings": {
    "gecko": { "id": "zorin-xp-ie-history@zorin-xp.local" }
  },
  "permissions": ["history", "tabs"],
  "browser_action": {
    "default_icon": { "16": "img/tb-history-16.png", "32": "img/tb-history.png" },
    "default_title": "Histórico"
  },
  "sidebar_action": {
    "default_panel": "sidebar.html",
    "default_title": "Histórico",
    "default_icon": "img/tb-history-16.png",
    "open_at_install": false
  },
  "background": { "scripts": ["background.js"] }
}
