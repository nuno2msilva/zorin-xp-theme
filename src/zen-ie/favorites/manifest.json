{
  "manifest_version": 2,
  "name": "Favoritos",
  "description": "A barra Favoritos do Internet Explorer 6 (Zorin XP).",
  "version": "1.3",
  "browser_specific_settings": {
    "gecko": { "id": "zorin-xp-ie-favorites@zorin-xp.local" }
  },
  "permissions": ["bookmarks", "tabs", "menus", "menus.overrideContext"],
  "browser_action": {
    "default_icon": { "16": "img/tb-favorites-16.png", "32": "img/tb-favorites.png" },
    "default_title": "Favoritos"
  },
  "sidebar_action": {
    "default_panel": "sidebar.html",
    "default_title": "Favoritos",
    "default_icon": "img/tb-favorites-16.png",
    "open_at_install": false
  },
  "background": { "scripts": ["background.js"] }
}
