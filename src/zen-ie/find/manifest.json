{
  "manifest_version": 2,
  "name": "Localizar",
  "description": "A janela Localizar do Internet Explorer 6 (Zorin XP).",
  "version": "1.1",
  "browser_specific_settings": {
    "gecko": { "id": "zorin-xp-ie-find@zorin-xp.local" }
  },
  "permissions": ["find", "tabs"],
  "incognito": "spanning",
  "commands": {
    "localizar": {
      "suggested_key": { "default": "Ctrl+F" },
      "description": "Localizar nesta página"
    }
  },
  "browser_action": {
    "default_icon": { "16": "img/tb-search-16.png", "32": "img/tb-search.png" },
    "default_title": "Procurar"
  },
  "background": { "scripts": ["background.js"] }
}
