{
  "manifest_version": 2,
  "name": "Zorin XP: sons do Internet Explorer",
  "description": "O clique do Internet Explorer do XP (Iniciar navegação) ao abrir uma página, e os sons da barra de informações (pop-up bloqueado, pedidos).",
  "version": "1.3",
  "browser_specific_settings": {
    "gecko": {
      "id": "zorin-xp-ie-sounds@zorin-xp.local"
    }
  },
  "permissions": [
    "tabs"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "infobar.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
