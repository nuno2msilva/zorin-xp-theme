/*
 * Page scrollbars like XP's (the Explorer's and IE6's: luna.msstyles'
 * ScrollBar, the same images as the GTK theme). An "agent" level sheet,
 * registered by the src/zen-ie/scrollbars extension: only at that level can
 * the bar's parts be reached (scrollbar, scrollbarbutton, slider, thumb) —
 * userContent.css only changes the colours. The images are embedded
 * ({{img:...}}, tools/builders/zenie.py) so pages do not have to read them from disk.
 * (The vertical bar has the vertical attribute; the horizontal one has none.)
 * 17 px; arrows with hover / pressed / disabled; thumb with the grip lines in
 * the middle (normal, hover, dragging); trough.
 */
@namespace url("http://www.mozilla.org/keymaster/gatekeeper/there.is.only.xul");

/* (the bar itself keeps Firefox's drawing: with "appearance: none" it
   stopped taking space; the trough is painted on the slider, which covers it
   between the arrows) */
scrollbar {
  background-color: transparent !important;
  border: 0 !important;
  padding: 0 !important;
  margin: 0 !important;
  opacity: 1 !important;
}

slider {
  appearance: none !important;
  border: 0 !important;
  margin: 0 !important;
  padding: 0 !important;
}
/* (XP stretches images by repeating columns, without smoothing) */
slider, thumb, scrollbarbutton { image-rendering: pixelated !important; }
scrollbar[vertical] slider {
  background: {{img:scroll-shaft-vert-normal-fill}} 0 0 / 100% 100% no-repeat !important;
  border-image: {{img:scroll-shaft-vert-normal}} 0 1 / 0 1px stretch !important;
}
scrollbar:not([vertical]) slider {
  background: {{img:scroll-shaft-horz-normal-fill}} 0 0 / 100% 100% no-repeat !important;
  border-image: {{img:scroll-shaft-horz-normal}} 1 0 / 1px 0 stretch !important;
}
scrollbar[vertical]:disabled slider {
  background-image: {{img:scroll-shaft-vert-disabled-fill}} !important;
  border-image-source: {{img:scroll-shaft-vert-disabled}} !important;
}
scrollbar:not([vertical]):disabled slider {
  background-image: {{img:scroll-shaft-horz-disabled-fill}} !important;
  border-image-source: {{img:scroll-shaft-horz-disabled}} !important;
}

/* the thumb: 9-part image (5 px margins), the middle and the grip lines */
thumb {
  appearance: none !important;
  border: 0 !important;
  border-radius: 0 !important;
  margin: 0 !important;
  padding: 0 !important;
  background-repeat: no-repeat !important;
}
scrollbar[vertical] thumb {
  min-width: 17px !important;
  min-height: 8px !important;
  border-image: {{img:scroll-thumb-vert-normal}} 5 / 5px stretch !important;
  background-image: {{img:scroll-grip-vert-normal}}, {{img:scroll-thumb-vert-normal-fill}} !important;
  background-size: auto, 100% 100% !important;
  background-position: center, left top !important;
}
scrollbar[vertical] thumb:hover {
  border-image-source: {{img:scroll-thumb-vert-hover}} !important;
  background-image: {{img:scroll-grip-vert-hover}}, {{img:scroll-thumb-vert-hover-fill}} !important;
}
scrollbar[vertical] thumb:is(:active, [active="true"]) {
  border-image-source: {{img:scroll-thumb-vert-active}} !important;
  background-image: {{img:scroll-grip-vert-active}}, {{img:scroll-thumb-vert-active-fill}} !important;
}
scrollbar:not([vertical]) thumb {
  min-height: 17px !important;
  min-width: 8px !important;
  border-image: {{img:scroll-thumb-horz-normal}} 5 / 5px stretch !important;
  background-image: {{img:scroll-grip-horz-normal}}, {{img:scroll-thumb-horz-normal-fill}} !important;
  background-size: auto, 100% 100% !important;
  background-position: center, left top !important;
}
scrollbar:not([vertical]) thumb:hover {
  border-image-source: {{img:scroll-thumb-horz-hover}} !important;
  background-image: {{img:scroll-grip-horz-hover}}, {{img:scroll-thumb-horz-hover-fill}} !important;
}
scrollbar:not([vertical]) thumb:is(:active, [active="true"]) {
  border-image-source: {{img:scroll-thumb-horz-active}} !important;
  background-image: {{img:scroll-grip-horz-active}}, {{img:scroll-thumb-horz-active-fill}} !important;
}
scrollbar:disabled thumb { visibility: hidden !important; }

/* the arrows (17x17, already drawn) */
/* (the thin bars some sites ask for, scrollbar-width: thin, stay normal:
   layout.css.scrollbar-width-thin.disabled, in tools/setup/zenprefs.py —
   XP only had the 17 px one) */
scrollbarbutton {
  appearance: none !important;
  min-width: 17px !important;
  min-height: 17px !important;
  max-width: 17px !important;
  max-height: 17px !important;
  margin: 0 !important;
  padding: 0 !important;
  border: 0 !important;
  border-radius: 0 !important;
  background: none no-repeat !important;
}
scrollbar[vertical] scrollbarbutton[type="decrement"] { background-image: {{img:scroll-arrow-up-normal}} !important; }
scrollbar[vertical] scrollbarbutton[type="decrement"]:hover { background-image: {{img:scroll-arrow-up-hover}} !important; }
scrollbar[vertical] scrollbarbutton[type="decrement"]:hover:active { background-image: {{img:scroll-arrow-up-active}} !important; }
scrollbar[vertical]:disabled scrollbarbutton[type="decrement"] { background-image: {{img:scroll-arrow-up-disabled}} !important; }
scrollbar[vertical] scrollbarbutton[type="increment"] { background-image: {{img:scroll-arrow-down-normal}} !important; }
scrollbar[vertical] scrollbarbutton[type="increment"]:hover { background-image: {{img:scroll-arrow-down-hover}} !important; }
scrollbar[vertical] scrollbarbutton[type="increment"]:hover:active { background-image: {{img:scroll-arrow-down-active}} !important; }
scrollbar[vertical]:disabled scrollbarbutton[type="increment"] { background-image: {{img:scroll-arrow-down-disabled}} !important; }
scrollbar:not([vertical]) scrollbarbutton[type="decrement"] { background-image: {{img:scroll-arrow-left-normal}} !important; }
scrollbar:not([vertical]) scrollbarbutton[type="decrement"]:hover { background-image: {{img:scroll-arrow-left-hover}} !important; }
scrollbar:not([vertical]) scrollbarbutton[type="decrement"]:hover:active { background-image: {{img:scroll-arrow-left-active}} !important; }
scrollbar:not([vertical]):disabled scrollbarbutton[type="decrement"] { background-image: {{img:scroll-arrow-left-disabled}} !important; }
scrollbar:not([vertical]) scrollbarbutton[type="increment"] { background-image: {{img:scroll-arrow-right-normal}} !important; }
scrollbar:not([vertical]) scrollbarbutton[type="increment"]:hover { background-image: {{img:scroll-arrow-right-hover}} !important; }
scrollbar:not([vertical]) scrollbarbutton[type="increment"]:hover:active { background-image: {{img:scroll-arrow-right-active}} !important; }
scrollbar:not([vertical]):disabled scrollbarbutton[type="increment"] { background-image: {{img:scroll-arrow-right-disabled}} !important; }

/* the corner between the two bars: XP's button colour */
scrollcorner {
  appearance: none !important;
  background: #ece9d8 !important;
}
