/* =====================================================================
 * Title bars (Window.Caption) — measurements checked to the pixel against
 * XP captures:
 *   30 px high (SM_CYCAPTION 26 + frame 4), 21×21 buttons at y = 6,
 *   minimize/maximize/close at W-73 / W-50 / W-27 (2 px between them,
 *   6 px to the right edge), 16×16 icon at (6, 8), text from x = 26.
 *   Text: Trebuchet MS Bold 10 pt (13 px), white with a 1,1 #0A1883 shadow;
 *   inactive #D8E4F8 without shadow.
 * =================================================================== */
headerbar, .titlebar:not(headerbar) {
  min-height: 21px;
  margin: 0;
  padding: 6px 6px 3px 6px;
  {{part:caption:focused}}
  color: @xp_caption_text;
  box-shadow: none;
  text-shadow: none;
}
headerbar:backdrop, .titlebar:not(headerbar):backdrop {
  {{state:caption:unfocused}}
  color: @xp_caption_inactive_text;
}
.maximized headerbar, .maximized .titlebar:not(headerbar),
.tiled headerbar, .tiled-left headerbar, .tiled-right headerbar {
  {{part:caption-max:focused}}
  /* as in XP: 26 px caption starting 1 px above the screen (25 show, from
   * the glow line on); the frame columns stay out */
  margin: -1px -4px 0 -4px;
  padding: 2px 3px 3px 1px;   /* buttons 3 px from the right and 1 px from the top (measured) */
}
.maximized headerbar:backdrop, .tiled headerbar:backdrop,
.tiled-left headerbar:backdrop, .tiled-right headerbar:backdrop { {{state:caption-max:unfocused}} }
.fullscreen headerbar { margin: 0; }

headerbar .title, .titlebar .title, headerbar windowtitle .title, windowtitle > .title {
  padding: 0 4px;
  font-family: "Trebuchet MS";
  font-weight: bold;
  font-size: 9.75pt;
  color: @xp_caption_text;
  text-shadow: 1px 1px @xp_caption_shadow;
}
headerbar:backdrop .title, .titlebar:backdrop .title {
  color: @xp_caption_inactive_text;
  text-shadow: none;
}
headerbar .subtitle, windowtitle > .subtitle {
  font-size: 7.5pt;
  color: @xp_caption_inactive_text;
  text-shadow: none;
}
headerbar separator { background: none; min-width: 6px; }

/* ---------------------------------------------------------------------
 * Normal buttons inside title bars (apps with their own headerbar):
 * shiny blue buttons like the window ones (CaptionButton), white text
 * ------------------------------------------------------------------- */
headerbar > button:not(.titlebutton), headerbar box > button, headerbar box > menubutton > button,
headerbar .linked > button, headerbar > menubutton > button {
  min-height: 15px;
  min-width: 15px;
  margin: 0 1px;
  padding: 3px 5px;
  border-style: solid;
  border-width: 0;
  border-image: url("assets/caption-button-focused-normal.png") 5 5 5 5 stretch;
  border-image-width: 5px;
  background-color: transparent;
  background-image: url("assets/caption-button-focused-normal-fill.png");
  background-size: 100% 100%;
  color: @xp_caption_text;
  -gtk-icon-shadow: none;
  text-shadow: none;
  box-shadow: none;
}
headerbar > button:not(.titlebutton):hover, headerbar box > button:hover, headerbar box > menubutton > button:hover,
headerbar .linked > button:hover {
  border-image-source: url("assets/caption-button-focused-hover.png");
  background-image: url("assets/caption-button-focused-hover-fill.png");
}
headerbar > button:not(.titlebutton):active, headerbar > button:not(.titlebutton):checked,
headerbar box > button:active, headerbar box > button:checked, headerbar box > menubutton > button:checked,
headerbar .linked > button:active, headerbar .linked > button:checked {
  border-image-source: url("assets/caption-button-focused-active.png");
  background-image: url("assets/caption-button-focused-active-fill.png");
}
headerbar > button:not(.titlebutton):disabled, headerbar:backdrop > button:not(.titlebutton),
headerbar box > button:disabled, headerbar:backdrop box > button {
  border-image-source: url("assets/caption-button-unfocused-normal.png");
  background-image: url("assets/caption-button-unfocused-normal-fill.png");
  color: @xp_caption_inactive_text;
}
headerbar > button.flat:not(.titlebutton):not(:hover):not(:active):not(:checked),
headerbar box > button.flat:not(:hover):not(:active):not(:checked) {
  border-image: none;
  background-image: none;
}
headerbar entry, headerbar spinbutton { margin: 0 1px; }
headerbar label { color: inherit; }
headerbar image { color: inherit; }

/* Window buttons: images pre-drawn by uxtheme (21×21, glyph included) */
headerbar button.titlebutton, .titlebar button.titlebutton, windowcontrols > button {
  min-width: 21px;
  min-height: 21px;
  margin: 0 0 0 2px;
  padding: 0;
  border: 0;
  border-image: none;
  border-radius: 0;
  box-shadow: none;
  color: transparent;
  -gtk-icon-source: none;
  -gtk-icon-shadow: none;
  background-color: transparent;
  background-repeat: no-repeat;
  background-position: left top;
  background-size: auto;
  outline: none;
}
windowcontrols { margin: 0; /*@gtk4*/border-spacing: 0;/*@end*/ }
windowcontrols > button > image, headerbar button.titlebutton > image {
  -gtk-icon-source: none;
  color: transparent;
  opacity: 0;
}
windowcontrols > button:first-child, headerbar button.titlebutton:first-child { margin-left: 0; }
windowcontrols.start { margin-right: 6px; }

/*@gtk3*/
headerbar button.titlebutton.minimize { background-image: url("assets/caption-min-focused-normal.png"); }
headerbar button.titlebutton.minimize:hover { background-image: url("assets/caption-min-focused-hover.png"); }
headerbar button.titlebutton.minimize:active { background-image: url("assets/caption-min-focused-active.png"); }
headerbar button.titlebutton.minimize:backdrop { background-image: url("assets/caption-min-unfocused-normal.png"); }
headerbar button.titlebutton.minimize:backdrop:hover { background-image: url("assets/caption-min-unfocused-hover.png"); }
headerbar button.titlebutton.maximize { background-image: url("assets/caption-max-focused-normal.png"); }
headerbar button.titlebutton.maximize:hover { background-image: url("assets/caption-max-focused-hover.png"); }
headerbar button.titlebutton.maximize:active { background-image: url("assets/caption-max-focused-active.png"); }
headerbar button.titlebutton.maximize:backdrop { background-image: url("assets/caption-max-unfocused-normal.png"); }
headerbar button.titlebutton.maximize:backdrop:hover { background-image: url("assets/caption-max-unfocused-hover.png"); }
.maximized headerbar button.titlebutton.maximize { background-image: url("assets/caption-restore-focused-normal.png"); }
.maximized headerbar button.titlebutton.maximize:hover { background-image: url("assets/caption-restore-focused-hover.png"); }
.maximized headerbar button.titlebutton.maximize:active { background-image: url("assets/caption-restore-focused-active.png"); }
.maximized headerbar button.titlebutton.maximize:backdrop { background-image: url("assets/caption-restore-unfocused-normal.png"); }
headerbar button.titlebutton.close { background-image: url("assets/caption-close-focused-normal.png"); }
headerbar button.titlebutton.close:hover { background-image: url("assets/caption-close-focused-hover.png"); }
headerbar button.titlebutton.close:active { background-image: url("assets/caption-close-focused-active.png"); }
headerbar button.titlebutton.close:backdrop { background-image: url("assets/caption-close-unfocused-normal.png"); }
headerbar button.titlebutton.close:backdrop:hover { background-image: url("assets/caption-close-unfocused-hover.png"); }
/*@end*/
/*@gtk4*/
windowcontrols > button.minimize { background-image: url("assets/caption-min-focused-normal.png"); }
windowcontrols > button.minimize:hover { background-image: url("assets/caption-min-focused-hover.png"); }
windowcontrols > button.minimize:active { background-image: url("assets/caption-min-focused-active.png"); }
windowcontrols > button.minimize:backdrop { background-image: url("assets/caption-min-unfocused-normal.png"); }
windowcontrols > button.minimize:backdrop:hover { background-image: url("assets/caption-min-unfocused-hover.png"); }
windowcontrols > button.maximize { background-image: url("assets/caption-max-focused-normal.png"); }
windowcontrols > button.maximize:hover { background-image: url("assets/caption-max-focused-hover.png"); }
windowcontrols > button.maximize:active { background-image: url("assets/caption-max-focused-active.png"); }
windowcontrols > button.maximize:backdrop { background-image: url("assets/caption-max-unfocused-normal.png"); }
windowcontrols > button.maximize:backdrop:hover { background-image: url("assets/caption-max-unfocused-hover.png"); }
.maximized windowcontrols > button.maximize { background-image: url("assets/caption-restore-focused-normal.png"); }
.maximized windowcontrols > button.maximize:hover { background-image: url("assets/caption-restore-focused-hover.png"); }
.maximized windowcontrols > button.maximize:active { background-image: url("assets/caption-restore-focused-active.png"); }
.maximized windowcontrols > button.maximize:backdrop { background-image: url("assets/caption-restore-unfocused-normal.png"); }
windowcontrols > button.close { background-image: url("assets/caption-close-focused-normal.png"); }
windowcontrols > button.close:hover { background-image: url("assets/caption-close-focused-hover.png"); }
windowcontrols > button.close:active { background-image: url("assets/caption-close-focused-active.png"); }
windowcontrols > button.close:backdrop { background-image: url("assets/caption-close-unfocused-normal.png"); }
windowcontrols > button.close:backdrop:hover { background-image: url("assets/caption-close-unfocused-hover.png"); }
/* window icon in the "icon:" layout (GTK4) */
windowcontrols > image.icon { min-width: 16px; min-height: 16px; margin: 2px 4px 3px 0; -gtk-icon-size: 16px; }

/* ---------------------------------------------------------------------
 * Frames of normal windows (mutter-x11-frames): mutter only accepts a frame
 * at the top, so GTK draws the caption without the 4 frame columns on each
 * side (caption-inner) and the Zorin XP extension adds the borders, the icon
 * and the left-aligned title outside/on top.
 * ------------------------------------------------------------------- */
/* mutter puts the caption (headerbar.default-decoration) inside a widget
 * that also has the .titlebar class: that wrapper gets no background nor
 * margins, otherwise the general caption rule applied twice and the caption
 * ended up 39 px instead of 30 (and the extension did not recognise it) */
window > widget.titlebar, window > widget.titlebar:backdrop,
window.csd > widget.titlebar, window.csd > widget.titlebar:backdrop,
window.maximized > widget.titlebar {
  min-height: 0;
  margin: 0;
  padding: 0;
  border: 0;
  border-image: none;
  background: none;
}
widget.titlebar > headerbar.default-decoration, widget.default-decoration > headerbar.titlebar {
  margin: 0;
  padding: 6px 2px 3px 0;
  {{part:caption-inner:focused}}
}
widget.titlebar > headerbar.default-decoration:backdrop,
widget.default-decoration > headerbar.titlebar:backdrop { {{state:caption-inner:unfocused}} }
widget.titlebar > headerbar.default-decoration .title,
widget.default-decoration > headerbar.titlebar .title { color: transparent; text-shadow: none; }
.maximized widget.titlebar > headerbar.default-decoration,
.maximized widget.default-decoration > headerbar.titlebar {
  margin: -4px -4px 0 -4px;
  padding: 6px 6px 3px 6px;
  {{part:caption-max:focused}}
}
.maximized widget.titlebar > headerbar.default-decoration:backdrop,
.maximized widget.default-decoration > headerbar.titlebar:backdrop { {{state:caption-max:unfocused}} }
/*@end*/

/* ---------------------------------------------------------------------
 * Client-side decorations (CSD): no shadow (XP had none), top corners
 * rounded like the caption
 * ------------------------------------------------------------------- */
decoration {
  border-radius: 8px 8px 0 0;
  box-shadow: none;
  margin: 0;
}
window.csd decoration, window.csd > decoration {
  box-shadow: 0 0 0 1px transparent;
  /* 4 px frame (FrameLeft/Right/Bottom) — GTK pulls the content in */
  border-style: solid;
  border-width: 0 4px 4px 4px;
  border-image: url("assets/frame-csd-focused.png") 0 4 4 4 stretch;
  border-image-width: 0 4px 4px 4px;
}
window.csd decoration:backdrop { border-image-source: url("assets/frame-csd-unfocused.png"); }
/* the caption covers the frame columns, as in XP */
window.csd > headerbar.titlebar, window.csd > .titlebar { margin-left: -4px; margin-right: -4px; }
window.csd.maximized decoration, window.csd.fullscreen decoration, window.csd.tiled decoration,
window.csd.tiled-left decoration, window.csd.tiled-right decoration {
  border-width: 0;
  border-image: none;
}
window.csd.maximized decoration, window.csd.fullscreen decoration, window.csd.tiled decoration { border-radius: 0; }
/*@gtk3*/
/* menu windows are window.csd too: without the windows' blue frame (only
 * the menu's own outline and shadow) */

window.csd.popup decoration, window.csd.popup decoration:backdrop {
  border-width: 0;
  border-image: none;
  border-radius: 0;
}
tooltip.csd decoration { box-shadow: none; }
messagedialog.csd decoration { border-radius: 8px 8px 0 0; }
/*@end*/
window.solid-csd { padding: 0; }
